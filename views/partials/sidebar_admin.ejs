<div class="admin-sidebar d-flex flex-column">
  <div class="p-4 border-bottom border-secondary">
    <a href="/admin" class="fs-4 fw-bold text-white text-decoration-none d-flex align-items-center gap-2">
      <i class="bi bi-compass-fill text-primary"></i> WanderLust
    </a>
    <div class="small text-muted mt-1">Admin Management System</div>
  </div>
  
  <div class="py-3 flex-grow-1">
    <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">
      <i class="bi bi-speedometer2 fs-5"></i> Dashboard Analytics
    </a>
    <a href="/admin/tours" class="<%= currentPath.startsWith('/admin/tours') ? 'active' : '' %>">
      <i class="bi bi-map-fill fs-5"></i> Tour Packages
    </a>
    <a href="/admin/destinations" class="<%= currentPath.startsWith('/admin/destinations') ? 'active' : '' %>">
      <i class="bi bi-geo-alt-fill fs-5"></i> Destinations
    </a>
    <a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">
      <i class="bi bi-grid-fill fs-5"></i> Tour Categories
    </a>
    <a href="/admin/bookings" class="<%= currentPath.startsWith('/admin/bookings') ? 'active' : '' %>">
      <i class="bi bi-ticket-perforated-fill fs-5"></i> Tour Bookings
    </a>
    <a href="/admin/customers" class="<%= currentPath.startsWith('/admin/customers') ? 'active' : '' %>">
      <i class="bi bi-people-fill fs-5"></i> Customers
    </a>
    <a href="/admin/reviews" class="<%= currentPath.startsWith('/admin/reviews') ? 'active' : '' %>">
      <i class="bi bi-star-fill fs-5"></i> Customer Reviews
    </a>
    <a href="/admin/coupons" class="<%= currentPath.startsWith('/admin/coupons') ? 'active' : '' %>">
      <i class="bi bi-tags-fill fs-5"></i> Discount Coupons
    </a>
    <a href="/admin/contacts" class="<%= currentPath.startsWith('/admin/contacts') ? 'active' : '' %>">
      <i class="bi bi-envelope-fill fs-5"></i> Contact Messages
    </a>
    <a href="/admin/newsletters" class="<%= currentPath.startsWith('/admin/newsletters') ? 'active' : '' %>">
      <i class="bi bi-send-fill fs-5"></i> Subscribers
    </a>
    <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">
      <i class="bi bi-gear-fill fs-5"></i> Settings
    </a>
  </div>

  <div class="p-3 border-top border-secondary">
    <a href="/logout" class="text-danger fw-bold">
      <i class="bi bi-box-arrow-right fs-5"></i> Admin Logout
    </a>
  </div>
</div>
