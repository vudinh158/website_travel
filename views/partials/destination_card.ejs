<div class="destination-card">
  <img src="<%= destination.banner %>" alt="<%= destination.name %>" loading="lazy">
  <div class="destination-overlay">
    <span class="badge bg-primary text-white w-auto mb-2"><%= destination.country %></span>
    <h4 class="fw-bold mb-1"><%= destination.name %></h4>
    <a href="/destinations/<%= destination.slug %>" class="text-white text-decoration-none small fw-semibold">
      Explore Destination <i class="bi bi-chevron-right"></i>
    </a>
  </div>
</div>
