<div class="dashboard-header-panel mb-4 p-4 rounded-4 bg-white border shadow-sm">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 border-bottom">
    <div class="d-flex align-items-center gap-3">
      <img src="<%= (typeof user !== 'undefined' && user && user.avatar) ? user.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80' %>" class="rounded-circle border shadow-sm" width="56" height="56" style="object-fit:cover;">
      <div>
        <h4 class="fw-bold mb-0 text-dark">Welcome, <%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Traveler' %>!</h4>
        <span class="text-muted small"><%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %> &bull; Customer Account</span>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/tours" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-semibold">
        <i class="bi bi-compass me-1"></i>Explore Tours
      </a>
      <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
        <i class="bi bi-box-arrow-right me-1"></i>Sign Out
      </a>
    </div>
  </div>

  <!-- Dashboard Navigation Tabs -->
  <ul class="nav nav-pills gap-2 mt-3 dashboard-pills flex-nowrap overflow-x-auto pb-1">
    <li class="nav-item">
      <a class="nav-link rounded-pill px-3 py-2 fw-semibold <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'active' : '' %>" href="/dashboard">
        <i class="bi bi-speedometer2 me-1"></i> Overview
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link rounded-pill px-3 py-2 fw-semibold <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/dashboard/bookings')) ? 'active' : '' %>" href="/dashboard/bookings">
        <i class="bi bi-ticket-perforated-fill me-1"></i> My Bookings
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link rounded-pill px-3 py-2 fw-semibold <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/dashboard/wishlist')) ? 'active' : '' %>" href="/dashboard/wishlist">
        <i class="bi bi-heart-fill me-1 text-danger"></i> Saved Wishlist
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link rounded-pill px-3 py-2 fw-semibold <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/dashboard/profile')) ? 'active' : '' %>" href="/dashboard/profile">
        <i class="bi bi-person-gear me-1"></i> Profile Settings
      </a>
    </li>
  </ul>
</div>
