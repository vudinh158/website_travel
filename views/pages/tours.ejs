<!-- ==========================================================================
     Tranoi Travel - Vietnam Tours Directory & Search (On The Go Tours Style)
     ========================================================================== -->

<!-- Hero Section with Brand Gradient -->
<div class="bg-primary text-white pt-5 pb-5 position-relative" style="background: linear-gradient(135deg, #004AAD 0%, #002d6b 100%);">
  <div class="container pt-2 pb-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page">Vietnam Tours</li>
      </ol>
    </nav>
    <div class="d-inline-flex align-items-center gap-2 mb-2">
      <span class="badge bg-accent text-white px-3 py-2 rounded-pill fw-bold text-uppercase" style="background-color: #FF8F4C !important;">
        <i class="bi bi-shield-check me-1"></i> 100% Curated Vietnam Journeys
      </span>
      <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold">
        Private &amp; Partial-Guided
      </span>
    </div>
    <h1 class="display-5 fw-extrabold text-white mb-2">Vietnam Tours &amp; Tailor-Made Holidays</h1>
    <p class="fs-5 text-white-50 mb-4" style="max-width: 820px; line-height: 1.6;">
      Compare our signature Vietnam itineraries with an instant choice between fully chauffeured Private journeys and flexible Partial-guided trips with unguided leisure windows.
    </p>

    <!-- Trust Quality Badges Row -->
    <div class="d-flex flex-wrap gap-2 pt-2">
      <div class="trust-badge-pill">
        <i class="bi bi-calendar-check-fill text-accent"></i>
        <span>Guaranteed Daily &amp; Weekly Departures</span>
      </div>
      <div class="trust-badge-pill">
        <i class="bi bi-sliders text-accent"></i>
        <span>Dual Format Flexibility</span>
      </div>
      <div class="trust-badge-pill">
        <i class="bi bi-headset text-accent"></i>
        <span>24/7 Local Concierge in Vietnam</span>
      </div>
      <div class="trust-badge-pill">
        <i class="bi bi-star-fill text-warning"></i>
        <span>4.98 / 5 Rating from Discerning Guests</span>
      </div>
    </div>
  </div>
</div>

<div class="container mb-5">
  <!-- Fast Search Finder Bar (Matching On The Go Tours Search Parameters) -->
  <div class="tours-hero-search-wrapper mb-5">
    <form id="fast-search-form" action="/tours" method="GET">
      <div class="row g-2 align-items-center">
        <!-- Destination / Region -->
        <div class="col-lg-3 col-md-6 col-12">
          <div class="search-field-pill">
            <span class="form-label"><i class="bi bi-geo-alt-fill text-primary me-1"></i> Destination</span>
            <select name="region" id="fast-destination" class="form-select">
              <option value="all" <%= (!query.region || query.region === 'all') ? 'selected' : '' %>>All Vietnam</option>
              <option value="north" <%= query.region === 'north' ? 'selected' : '' %>>North Vietnam (Hanoi, Ha Long, Sapa)</option>
              <option value="central" <%= query.region === 'central' ? 'selected' : '' %>>Central Vietnam (Hue, Hoi An, Da Nang)</option>
              <option value="south" <%= query.region === 'south' ? 'selected' : '' %>>South Vietnam (Saigon, Mekong Delta)</option>
              <option value="multi-region" <%= query.region === 'multi-region' ? 'selected' : '' %>>Multi-Region Grand Circuits</option>
            </select>
          </div>
        </div>

        <!-- Departure Date / Anytime -->
        <div class="col-lg-3 col-md-6 col-6">
          <div class="search-field-pill">
            <span class="form-label"><i class="bi bi-calendar3 text-primary me-1"></i> When / Departure</span>
            <select name="departureWindow" id="fast-departure" class="form-select">
              <option value="anytime" <%= anytime ? 'selected' : '' %>>Anytime / Flexible Dates</option>
              <option value="spring">Spring 2026 (Mar - May)</option>
              <option value="autumn">Autumn 2026 (Sep - Nov)</option>
              <option value="winter">Winter 2026 - 2027 (Dec - Feb)</option>
            </select>
          </div>
        </div>

        <!-- Number of Guests / Adults -->
        <div class="col-lg-2 col-md-6 col-6">
          <div class="search-field-pill">
            <span class="form-label"><i class="bi bi-people-fill text-primary me-1"></i> Travelers</span>
            <select name="numberOfAdults" id="fast-adults" class="form-select">
              <option value="1" <%= numberOfAdults === 1 ? 'selected' : '' %>>1 Solo Traveler</option>
              <option value="2" <%= numberOfAdults === 2 ? 'selected' : '' %>>2 Adults (Couple/Duo)</option>
              <option value="3" <%= numberOfAdults === 3 ? 'selected' : '' %>>3 Adults</option>
              <option value="4" <%= numberOfAdults === 4 ? 'selected' : '' %>>4 Adults (Family/Group)</option>
              <option value="5" <%= numberOfAdults >= 5 ? 'selected' : '' %>>5+ Guests (Private Group)</option>
            </select>
          </div>
        </div>

        <!-- Keyword Search -->
        <div class="col-lg-2 col-md-6 col-12">
          <div class="search-field-pill">
            <span class="form-label"><i class="bi bi-search text-primary me-1"></i> Keywords</span>
            <input type="text" name="search" id="fast-search" class="form-control" placeholder="e.g. Ha Long, Sapa" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          </div>
        </div>

        <!-- Submit Button -->
        <div class="col-lg-2 col-md-12 col-12">
          <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm" style="background-color: #004AAD; border-color: #004AAD;">
            <i class="bi bi-funnel-fill"></i>
            <span>Search Tours</span>
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Mobile Filters Toggle Button -->
  <div class="d-lg-none mb-3">
    <button class="btn btn-outline-primary w-100 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse" aria-expanded="false" aria-controls="sidebarCollapse">
      <i class="bi bi-sliders"></i> Filter Tours &amp; Styles
    </button>
  </div>

  <!-- Main Grid: Sidebar Filters (col-lg-3) & Results (col-lg-9) -->
  <div class="row g-4">
    <!-- Left Sidebar: Filter Facets -->
    <div class="col-lg-3">
      <div class="collapse d-lg-block" id="sidebarCollapse">
        <div class="tour-sidebar-card p-4">
          <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
            <div class="fw-bold fs-6 text-dark d-flex align-items-center gap-2">
              <i class="bi bi-filter-circle-fill text-primary fs-5"></i>
              <span>Refine Tours</span>
            </div>
            <a href="/tours" class="text-decoration-none small text-danger fw-semibold">
              <i class="bi bi-arrow-counterclockwise"></i> Reset all
            </a>
          </div>

          <!-- Active Filter Chips -->
          <div id="active-filter-chips" class="mb-3">
            <% if (query.duration) { %>
              <span class="active-chip">
                <span><%= query.duration %> Days</span>
                <span class="active-chip-remove" data-param="duration">&times;</span>
              </span>
            <% } %>
            <% if (query.format) { %>
              <span class="active-chip">
                <span><%= query.format === 'partial-guided' ? 'Partial-Guided' : 'Private' %></span>
                <span class="active-chip-remove" data-param="format">&times;</span>
              </span>
            <% } %>
            <% if (query.region && query.region !== 'all') { %>
              <span class="active-chip">
                <span><%= query.region.charAt(0).toUpperCase() + query.region.slice(1) %></span>
                <span class="active-chip-remove" data-param="region">&times;</span>
              </span>
            <% } %>
            <% if (query.pace && query.pace !== 'all') { %>
              <span class="active-chip">
                <span><%= query.pace %> Pace</span>
                <span class="active-chip-remove" data-param="pace">&times;</span>
              </span>
            <% } %>
            <% if (query.theme && query.theme !== 'all') { %>
              <span class="active-chip">
                <span><%= query.theme.charAt(0).toUpperCase() + query.theme.slice(1) %></span>
                <span class="active-chip-remove" data-param="theme">&times;</span>
              </span>
            <% } %>
            <% if (searchQuery) { %>
              <span class="active-chip">
                <span>"<%= searchQuery %>"</span>
                <span class="active-chip-remove" data-param="search">&times;</span>
              </span>
            <% } %>
          </div>

          <!-- Filter Form for Checkboxes -->
          <form action="/tours" method="GET" id="tour-filter-form">
            <% if (searchQuery) { %>
              <input type="hidden" name="search" value="<%= searchQuery %>">
            <% } %>
            <input type="hidden" name="numberOfAdults" value="<%= numberOfAdults %>">
            <input type="hidden" name="sort" value="<%= sort %>">

            <!-- 1. Duration (Days) -->
            <div class="mb-4">
              <div class="filter-section-title" data-bs-toggle="collapse" data-bs-target="#filter-duration" aria-expanded="true">
                <span>Duration</span>
                <i class="bi bi-chevron-down"></i>
              </div>
              <div class="collapse show" id="filter-duration">
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="duration" value="" class="form-check-input mt-0" <%= !query.duration ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Any Duration</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="duration" value="5-7" class="form-check-input mt-0" <%= query.duration === '5-7' || query.duration === '7' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>5 - 7 Days (1 Week)</span>
                  </span>
                  <span class="filter-count-badge">1</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="duration" value="8-10" class="form-check-input mt-0" <%= query.duration === '8-10' || query.duration === '10' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>8 - 10 Days (Flagship)</span>
                  </span>
                  <span class="filter-count-badge">1</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="duration" value="11-14" class="form-check-input mt-0" <%= query.duration === '11-14' || query.duration === '14' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>11 - 14 Days (2 Weeks)</span>
                  </span>
                  <span class="filter-count-badge">1</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="duration" value="15-21" class="form-check-input mt-0" <%= query.duration === '15-21' || query.duration === '21' || query.duration === '21+' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>15 - 21 Days (3 Weeks)</span>
                  </span>
                  <span class="filter-count-badge">1</span>
                </label>
              </div>
            </div>

            <!-- 2. Format Style (Private vs Partial-Guided) -->
            <div class="mb-4">
              <div class="filter-section-title" data-bs-toggle="collapse" data-bs-target="#filter-format" aria-expanded="true">
                <span>Tour Format</span>
                <i class="bi bi-chevron-down"></i>
              </div>
              <div class="collapse show" id="filter-format">
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="format" value="" class="form-check-input mt-0" <%= (!query.format || query.format === 'all') ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Both Formats</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="format" value="partial-guided" class="form-check-input mt-0" <%= query.format === 'partial-guided' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Partial-Guided</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="format" value="private" class="form-check-input mt-0" <%= query.format === 'private' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Private Chauffeured</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
              </div>
            </div>

            <!-- 3. Region Filter -->
            <div class="mb-4">
              <div class="filter-section-title" data-bs-toggle="collapse" data-bs-target="#filter-region" aria-expanded="true">
                <span>Region</span>
                <i class="bi bi-chevron-down"></i>
              </div>
              <div class="collapse show" id="filter-region">
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="region" value="all" class="form-check-input mt-0" <%= (!query.region || query.region === 'all') ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>All Regions</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="region" value="north" class="form-check-input mt-0" <%= query.region === 'north' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>North Vietnam</span>
                  </span>
                  <span class="filter-count-badge">1</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="region" value="multi-region" class="form-check-input mt-0" <%= query.region === 'multi-region' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Multi-Region Circuit</span>
                  </span>
                  <span class="filter-count-badge">3</span>
                </label>
              </div>
            </div>

            <!-- 4. Pace Filter -->
            <div class="mb-4">
              <div class="filter-section-title" data-bs-toggle="collapse" data-bs-target="#filter-pace" aria-expanded="true">
                <span>Travel Pace</span>
                <i class="bi bi-chevron-down"></i>
              </div>
              <div class="collapse show" id="filter-pace">
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="pace" value="all" class="form-check-input mt-0" <%= (!query.pace || query.pace === 'all') ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Any Pace</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="pace" value="Moderate" class="form-check-input mt-0" <%= query.pace === 'Moderate' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Moderate Pace</span>
                  </span>
                  <span class="filter-count-badge">3</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="pace" value="Relaxed" class="form-check-input mt-0" <%= query.pace === 'Relaxed' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Relaxed / Unhurried</span>
                  </span>
                  <span class="filter-count-badge">1</span>
                </label>
              </div>
            </div>

            <!-- 5. Theme / Style Filter -->
            <div class="mb-3">
              <div class="filter-section-title" data-bs-toggle="collapse" data-bs-target="#filter-theme" aria-expanded="true">
                <span>Theme &amp; Style</span>
                <i class="bi bi-chevron-down"></i>
              </div>
              <div class="collapse show" id="filter-theme">
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="theme" value="all" class="form-check-input mt-0" <%= (!query.theme || query.theme === 'all') ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>All Themes</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="theme" value="highlights" class="form-check-input mt-0" <%= query.theme === 'highlights' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Highlights &amp; Culture</span>
                  </span>
                  <span class="filter-count-badge">4</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="theme" value="family" class="form-check-input mt-0" <%= query.theme === 'family' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Family Journeys</span>
                  </span>
                  <span class="filter-count-badge">3</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="theme" value="culinary" class="form-check-input mt-0" <%= query.theme === 'culinary' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Food &amp; Street Gastronomy</span>
                  </span>
                  <span class="filter-count-badge">2</span>
                </label>
                <label class="filter-check-item">
                  <span class="d-flex align-items-center gap-2">
                    <input type="radio" name="theme" value="adventure" class="form-check-input mt-0" <%= query.theme === 'adventure' ? 'checked' : '' %> onchange="this.form.submit()">
                    <span>Active &amp; Mountains</span>
                  </span>
                  <span class="filter-count-badge">2</span>
                </label>
              </div>
            </div>
          </form>

          <!-- Specialist Assistance Card (High Trust & Conversion) -->
          <div class="sidebar-specialist-widget">
            <div class="d-flex align-items-center gap-3 mb-2">
              <div class="specialist-avatar-wrap">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="Linh Nguyen - Senior Curator">
                <span class="specialist-online-dot"></span>
              </div>
              <div>
                <span class="fw-bold fs-6 text-dark d-block">Need Custom Help?</span>
                <span class="small text-muted">Local Travel Specialist</span>
              </div>
            </div>
            <p class="small text-secondary mb-3" style="line-height: 1.45;">
              Not sure which length or format fits your style? Chat directly with our Vietnam destination experts.
            </p>
            <div class="d-flex flex-column gap-2">
              <a href="https://wa.me/84901234567" target="_blank" class="btn btn-outline-success btn-sm rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-whatsapp"></i> Chat via WhatsApp
              </a>
              <a href="/contact" class="btn btn-primary btn-sm rounded-pill fw-bold text-white text-center" style="background-color: #004AAD;">
                Request Custom Itinerary
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Results Header, Sort & Tour Cards -->
    <div class="col-lg-9">
      <!-- Results Utility Bar -->
      <div class="results-utility-bar d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Results Counter -->
        <div>
          <h2 class="fs-5 fw-bold text-dark mb-0">
            Showing <span id="visible-count" class="text-primary"><%= allTours.length %></span> Curated Vietnam <%= allTours.length === 1 ? 'Tour' : 'Tours' %>
          </h2>
          <span class="small text-muted">All prices in USD per guest &bull; Guaranteed departures</span>
        </div>

        <!-- Controls: Sort & View Mode Switcher -->
        <div class="d-flex align-items-center gap-3">
          <!-- Sort Selector -->
          <div class="d-flex align-items-center gap-2">
            <label for="tour-sort-select" class="small fw-bold text-muted text-nowrap d-none d-sm-inline">Sort by:</label>
            <select id="tour-sort-select" class="form-select form-select-sm rounded-3 bg-light border" style="min-width: 175px;">
              <option value="recommended" <%= sort === 'recommended' ? 'selected' : '' %>>Recommended</option>
              <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="duration-asc" <%= sort === 'duration-asc' ? 'selected' : '' %>>Duration: Short to Long</option>
              <option value="duration-desc" <%= sort === 'duration-desc' ? 'selected' : '' %>>Duration: Long to Short</option>
              <option value="rating-desc" <%= sort === 'rating-desc' ? 'selected' : '' %>>Highest Rated</option>
            </select>
          </div>

          <!-- View Mode: List vs Grid Toggle -->
          <div class="d-flex align-items-center gap-1 border-start ps-3">
            <button type="button" class="view-mode-btn active" id="view-mode-list" title="Detailed List View">
              <i class="bi bi-list-task fs-5"></i>
            </button>
            <button type="button" class="view-mode-btn" id="view-mode-grid" title="Compact Grid View">
              <i class="bi bi-grid-fill fs-6"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Tour Cards Container -->
      <div id="tours-list-container" class="tours-list-mode">
        <% if (allTours && allTours.length > 0) { %>
          <div class="row g-4 tours-items-row">
            <% allTours.forEach(tour => { %>
              <%
                // Parse route stops
                let routeStops = [];
                try {
                  const pts = typeof tour.routeMapPoints === 'string' ? JSON.parse(tour.routeMapPoints) : tour.routeMapPoints;
                  if (Array.isArray(pts)) {
                    routeStops = pts.map(p => typeof p === 'string' ? p : (p.name || p.title || '')).filter(Boolean);
                  }
                } catch(e) {}
                if (routeStops.length === 0 && tour.destination && tour.destination.name) {
                  routeStops = [tour.destination.name];
                }

                // Parse highlights
                let highlightsList = [];
                try {
                  const hls = typeof tour.highlights === 'string' ? JSON.parse(tour.highlights) : tour.highlights;
                  if (Array.isArray(hls)) highlightsList = hls;
                } catch(e) {}

                // Clean tour display name
                const displayName = tour.name ? tour.name.replace(/\s*-\s*(Private|Partial-Guided|Guided).*$/i, '').trim() : 'Vietnam Tour Package';
                const startingPrice = Math.round(tour.pricePartialGuided || tour.discountPrice || tour.price);
                const privatePrice = Math.round(tour.pricePrivate || tour.price * 1.25);
                const ratingNumber = tour.rating ? Number(tour.rating).toFixed(2) : '4.98';
                const reviewCount = tour.totalReviews || 35;
              %>

              <div class="col-12 tour-card-col">
                <div class="otg-tour-card">
                  <div class="row g-0 h-100">
                    <!-- Left: Card Media Thumbnail -->
                    <div class="col-lg-4 col-md-5 col-12 otg-card-media">
                      <a href="/tours/<%= tour.slug %>" class="d-block w-100 h-100 position-relative">
                        <img src="<%= tour.featuredImage %>" alt="<%= displayName %>" class="otg-card-img" loading="lazy">
                        
                        <!-- Floating Badges Top Left -->
                        <div class="otg-badge-top-left">
                          <span class="otg-badge-duration">
                            <i class="bi bi-clock-history me-1"></i> <%= tour.duration %>
                          </span>
                          <span class="otg-badge-format">
                            <i class="bi bi-sliders me-1"></i> Private &amp; Partial-Guided
                          </span>
                          <% if (tour.isBestSeller) { %>
                            <span class="otg-badge-bestseller">
                              <i class="bi bi-fire me-1"></i> Best Seller
                            </span>
                          <% } %>
                        </div>

                        <!-- Departure City Tag Bottom -->
                        <div class="otg-card-departure-tag">
                          <i class="bi bi-geo-alt-fill text-accent me-1"></i> Starts in <%= tour.departureLocation ? tour.departureLocation.split(',')[0] : 'Hanoi' %>
                        </div>
                      </a>
                    </div>

                    <!-- Center: Comprehensive Logistics & Itinerary Highlights -->
                    <div class="col-lg-5 col-md-7 col-12 otg-card-content d-flex flex-column justify-content-between">
                      <div>
                        <!-- Route Stops Breadcrumb Chain -->
                        <% if (routeStops.length > 0) { %>
                          <div class="otg-route-trail">
                            <% routeStops.forEach((stop, idx) => { %>
                              <span class="otg-route-stop"><%= stop %></span>
                              <% if (idx < routeStops.length - 1) { %>
                                <span class="otg-route-arrow">&rarr;</span>
                              <% } %>
                            <% }) %>
                          </div>
                        <% } %>

                        <!-- Tour Title -->
                        <h3 class="otg-card-title">
                          <a href="/tours/<%= tour.slug %>">
                            <%= displayName %>
                          </a>
                        </h3>

                        <!-- Quick Specs Row (Pace, Group Size, Transportation) -->
                        <div class="otg-specs-row">
                          <span class="otg-spec-item">
                            <i class="bi bi-speedometer2"></i>
                            <span><%= tour.pace %> Pace</span>
                          </span>
                          <span class="otg-spec-item">
                            <i class="bi bi-people"></i>
                            <span>Private (2-8) or Small Group</span>
                          </span>
                        </div>

                        <!-- Short Description -->
                        <p class="otg-card-excerpt">
                          <%= truncateText(tour.shortDescription, 150) %>
                        </p>

                        <!-- Highlights Bullet Points with Green Checkmarks -->
                        <% if (highlightsList.length > 0) { %>
                          <ul class="otg-highlights-list">
                            <% highlightsList.slice(0, 2).forEach(item => { %>
                              <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <span><%= item %></span>
                              </li>
                            <% }) %>
                          </ul>
                        <% } %>
                      </div>
                    </div>

                    <!-- Right: Pricing, Review Score & Conversion CTAs -->
                    <div class="col-lg-3 col-md-12 col-12 otg-card-pricing">
                      <!-- Rating Header -->
                      <div class="otg-rating-score">
                        <span class="otg-rating-badge">
                          <i class="bi bi-star-fill text-warning"></i> <%= ratingNumber %>
                        </span>
                        <span class="small text-muted fw-semibold">
                          <%= reviewCount %> reviews &bull; Exceptional
                        </span>
                      </div>

                      <!-- Pricing Block -->
                      <div class="otg-price-block">
                        <div class="otg-price-label">Starting Price</div>
                        <div class="d-flex align-items-baseline gap-1">
                          <span class="otg-price-amount">$<%= startingPrice.toLocaleString() %></span>
                          <span class="text-muted small">/ guest</span>
                        </div>
                        <div class="otg-price-subtext">Partial-Guided with free leisure time</div>
                        <div class="otg-private-comparison">
                          <span>Chauffeured Private: from $<%= privatePrice.toLocaleString() %></span>
                        </div>
                      </div>

                      <!-- Action Buttons -->
                      <div>
                        <a href="/tours/<%= tour.slug %>" class="otg-btn-primary">
                          View Itinerary &rarr;
                        </a>
                        <button type="button" 
                                class="otg-btn-enquire" 
                                data-bs-toggle="modal" 
                                data-bs-target="#quickEnquiryModal"
                                data-tour-name="<%= displayName %>"
                                data-tour-slug="<%= tour.slug %>"
                                data-tour-duration="<%= tour.duration %>"
                                data-tour-format="partial-guided"
                                data-tour-guests="<%= numberOfAdults %>">
                          <i class="bi bi-send me-1"></i> Quick Enquiry
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <!-- Empty State (No Tours Match Criteria) -->
          <div class="p-5 text-center bg-white rounded-4 shadow-sm border">
            <div class="mb-3">
              <span class="badge bg-light text-primary p-3 rounded-circle fs-3">
                <i class="bi bi-compass"></i>
              </span>
            </div>
            <h3 class="fw-bold mb-2 text-dark">No Tours Found Matching Your Filters</h3>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 520px;">
              We couldn't find any packages matching all selected criteria. Try adjusting your duration, region, or pace filter.
            </p>
            <a href="/tours" class="btn btn-primary rounded-pill px-4 py-2 fw-bold" style="background-color: #004AAD;">
              <i class="bi bi-arrow-counterclockwise me-1"></i> Clear All Filters
            </a>
          </div>
        <% } %>
      </div>

      <!-- Bottom Tailor-Made Advice Banner -->
      <div class="card border-0 rounded-4 p-4 mt-4 shadow-sm text-white" style="background: linear-gradient(135deg, #004AAD 0%, #002255 100%);">
        <div class="row align-items-center">
          <div class="col-lg-8">
            <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Tailor-Made Available</span>
            <h3 class="fw-bold mb-2">Looking for a Specific Route or Custom Dates?</h3>
            <p class="text-white-50 mb-lg-0 mb-3">
              Every Tranoi Travel itinerary can be adjusted to fit your exact preferred dates, party size, boutique hotel category, and travel pace.
            </p>
          </div>
          <div class="col-lg-4 text-lg-end text-start">
            <a href="/contact" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-primary shadow-sm">
              Speak with a Local Curator &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================================================
     Quick Enquiry Modal (On The Go Tours High Conversion Feature)
     ========================================================================== -->
<div class="modal fade" id="quickEnquiryModal" tabindex="-1" aria-labelledby="quickEnquiryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
      <div class="modal-header modal-tranoi-header position-relative">
        <div>
          <span class="badge bg-accent text-white px-2 py-1 rounded-pill small mb-1">Instant Proposal</span>
          <h4 class="modal-title fw-bold text-white mb-0" id="quickEnquiryModalLabel">Quick Tour Enquiry</h4>
          <div class="d-flex align-items-center gap-2 mt-1">
            <span id="modal-tour-title-display" class="text-white-50 small fw-semibold">Tour Package</span>
            <span class="badge bg-white-50 text-white rounded-pill px-2 py-0" id="modal-tour-duration-badge" style="background: rgba(255,255,255,0.25);">Duration</span>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body modal-tranoi-body bg-light">
        <form action="/enquiry" method="POST" id="quick-enquiry-form">
          <input type="hidden" name="tourName" id="enquiry-tour-name" value="">
          <input type="hidden" name="tourSlug" id="enquiry-tour-slug" value="">

          <div class="row g-3 mb-3">
            <!-- Format Choice -->
            <div class="col-md-6">
              <label class="form-label small fw-bold text-dark">Preferred Travel Format</label>
              <select name="format" id="enquiry-format" class="form-select bg-white">
                <option value="partial-guided">Partial-Guided (Guided mornings &amp; free afternoons)</option>
                <option value="private">Private Chauffeured (Dedicated driver &amp; personal guide)</option>
                <option value="undecided">Help me choose the right format</option>
              </select>
            </div>

            <!-- Number of Guests -->
            <div class="col-md-6">
              <label class="form-label small fw-bold text-dark">Number of Guests</label>
              <select name="guests" id="enquiry-guests" class="form-select bg-white">
                <option value="1">1 Solo Guest</option>
                <option value="2" selected>2 Guests (Double / Twin)</option>
                <option value="3">3 Guests</option>
                <option value="4">4 Guests</option>
                <option value="5+">5+ Guests</option>
              </select>
            </div>

            <!-- Estimated Departure Date -->
            <div class="col-md-6">
              <label class="form-label small fw-bold text-dark">Approximate Travel Date</label>
              <input type="date" name="departureDate" class="form-control bg-white" placeholder="Select month or date">
            </div>

            <!-- Full Name -->
            <div class="col-md-6">
              <label class="form-label small fw-bold text-dark">Your Full Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control bg-white" required placeholder="e.g. Eleanor Vance">
            </div>

            <!-- Email Address -->
            <div class="col-md-6">
              <label class="form-label small fw-bold text-dark">Email Address <span class="text-danger">*</span></label>
              <input type="email" name="email" class="form-control bg-white" required placeholder="name@example.com">
            </div>

            <!-- Phone / WhatsApp -->
            <div class="col-md-6">
              <label class="form-label small fw-bold text-dark">Phone or WhatsApp</label>
              <input type="tel" name="phone" class="form-control bg-white" placeholder="+1 (555) 000-0000">
            </div>

            <!-- Special Requests / Notes -->
            <div class="col-12">
              <label class="form-label small fw-bold text-dark">Any specific interests or questions?</label>
              <textarea name="notes" class="form-control bg-white" rows="3" placeholder="Tell us about your room preferences, dietary requirements, or extra nights in Hanoi / Saigon..."></textarea>
            </div>
          </div>

          <div class="d-flex align-items-center justify-content-between pt-2">
            <span class="small text-muted">
              <i class="bi bi-shield-lock-fill text-success me-1"></i> No spam. Guaranteed reply within 12 - 24 hours.
            </span>
            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold" style="background-color: #004AAD; border-color: #004AAD;">
              Send Enquiry &rarr;
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Dedicated Client Script for Interactive Tour Search -->
<script src="/js/tours-page.js"></script>
