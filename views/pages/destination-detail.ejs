<div class="position-relative text-white mb-5" style="min-height: 400px; background: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.8)), url('<%= destination.banner %>') center/cover no-repeat; display: flex; align-items: flex-end;">
  <div class="container py-5">
    <span class="badge bg-primary mb-2 fs-6"><%= destination.country %></span>
    <h1 class="display-3 fw-extrabold text-white mb-2"><%= destination.name %></h1>
    <p class="fs-5 opacity-90 max-w-2xl mb-0"><%= destination.description %></p>
  </div>
</div>

<div class="container mb-5">
  <div class="row g-5">
    <!-- Main Content Column -->
    <div class="col-lg-8">
      <!-- Popular Attractions -->
      <% if (destination.attractions) { %>
        <div class="card border-0 shadow-sm p-4 rounded-4 mb-5">
          <h4 class="fw-bold mb-3"><i class="bi bi-star-fill text-warning me-2"></i> Key Attractions in <%= destination.name %></h4>
          <div class="row g-3">
            <% (typeof destination.attractions === 'string' ? JSON.parse(destination.attractions) : destination.attractions).forEach(att => { %>
              <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3">
                  <i class="bi bi-pin-map-fill text-primary fs-4"></i>
                  <span class="fw-bold"><%= att %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Travel Guide & Weather -->
      <div class="mb-5">
        <h4 class="fw-bold mb-3">Traveler's Guide</h4>
        <p class="text-secondary leading-relaxed fs-6"><%= destination.travelGuide %></p>
      </div>

      <!-- Tours in this Destination -->
      <div class="mb-5">
        <h3 class="fw-extrabold mb-4">Available Tours in <%= destination.name %></h3>
        <% if (destination.tours && destination.tours.length > 0) { %>
          <div class="row g-4">
            <% destination.tours.forEach(tour => { %>
              <div class="col-md-6">
                <%- include('../../partials/tour_card', { tour: tour }) %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-4 bg-light rounded-4 text-center text-muted">
            <p class="mb-0">No active tour packages currently available for this destination.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Weather & Fast Facts Sidebar -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-cloud-sun-fill text-warning me-2"></i> Weather & Climate</h5>
        <% if (destination.weatherInfo) { %>
          <% const weather = typeof destination.weatherInfo === 'string' ? JSON.parse(destination.weatherInfo) : destination.weatherInfo; %>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted">Average Temperature:</span>
            <span class="fw-bold"><%= weather.avgTemp || '25°C' %></span>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted">Best Season:</span>
            <span class="fw-bold"><%= weather.drySeason || weather.spring || 'Year Round' %></span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
