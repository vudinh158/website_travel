<!-- Guides Hub Header -->
<div class="bg-primary text-white py-5 mb-5" style="background: linear-gradient(135deg, #004AAD 0%, #002d6b 100%);">
  <div class="container py-3">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page">Travel Guides</li>
      </ol>
    </nav>
    <span class="badge bg-accent text-white px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">Practical Insights</span>
    <h1 class="display-4 fw-extrabold text-white mb-2">Vietnam Travel Guides</h1>
    <p class="fs-5 text-white-50 mb-0" style="max-width: 720px;">
      Essential advice written by our local destination specialists. From visa regulations and seasonal weather to choosing between private and partial-guided formats.
    </p>
  </div>
</div>

<div class="container mb-5">
  <div class="row g-4">
    <% guides.forEach(guide => { %>
      <div class="col-lg-4 col-md-6">
        <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden bg-white hover-lift transition-smooth">
          <div style="height: 220px;" class="position-relative">
            <img src="<%= guide.heroImage %>" alt="<%= guide.title %>" class="w-100 h-100" style="object-fit: cover;">
            <span class="position-absolute top-0 start-0 m-3 badge bg-primary text-white rounded-pill px-3 py-1"><%= guide.category %></span>
          </div>
          <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
                <span><i class="bi bi-clock me-1"></i> <%= guide.readTime %></span>
                <span>Vietnam</span>
              </div>
              <h5 class="fw-bold mb-2">
                <a href="/guides/<%= guide.slug %>" class="text-dark text-decoration-none hover-primary">
                  <%= guide.title %>
                </a>
              </h5>
              <p class="text-secondary small leading-relaxed mb-3">
                <%= truncateText(guide.excerpt || guide.body, 120) %>
              </p>
            </div>
            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
              <span class="text-muted small">Updated 2026</span>
              <a href="/guides/<%= guide.slug %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                Read Guide &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
