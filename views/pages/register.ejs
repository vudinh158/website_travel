<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
        <div class="text-center mb-4">
          <i class="bi bi-compass-fill fs-1 text-primary"></i>
          <h3 class="fw-extrabold mt-2">Create Account</h3>
          <p class="text-muted small">Join WanderLust to book tours and unlock member discounts</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger rounded-3 small"><%= error %></div>
        <% } %>

        <form action="/register" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold">Full Name</label>
            <input type="text" name="name" class="form-control" value="<%= formData.name || '' %>" placeholder="John Doe" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Email Address</label>
            <input type="email" name="email" class="form-control" value="<%= formData.email || '' %>" placeholder="john@example.com" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Phone Number</label>
            <input type="text" name="phone" class="form-control" value="<%= formData.phone || '' %>" placeholder="+1 (555) 000-0000">
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label small fw-bold">Password</label>
              <input type="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Confirm Password</label>
              <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-wanderlust btn-lg w-100 rounded-pill fw-bold mb-3">Create Free Account</button>
        </form>

        <div class="text-center text-muted small mt-3">
          Already have an account? <a href="/login" class="fw-bold text-primary text-decoration-none">Login Here</a>
        </div>
      </div>
    </div>
  </div>
</div>
