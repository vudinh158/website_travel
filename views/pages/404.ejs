<div class="container py-5 text-center" style="max-width: 600px;">
  <i class="bi bi-compass-fill display-1 text-primary mb-3"></i>
  <h1 class="display-3 fw-extrabold mb-2">404</h1>
  <h3 class="fw-bold mb-3"><%= typeof message !== 'undefined' ? message : 'Destination Not Found' %></h3>
  <p class="text-muted mb-4">The travel page or tour destination you are searching for might have moved, been renamed, or is temporarily offline.</p>
  <a href="/" class="btn btn-wanderlust btn-lg rounded-pill px-4"><i class="bi bi-house-fill me-2"></i> Return to Homepage</a>
</div>
