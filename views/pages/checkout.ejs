<div class="container py-5">
  <h2 class="fw-extrabold mb-4"><i class="bi bi-shield-lock-fill text-primary me-2"></i> Tour Checkout & Payment</h2>

  <div class="row g-5">
    <!-- Left Guest & Payment Details Form -->
    <div class="col-lg-7">
      <% if (!user) { %>
        <div class="alert alert-info rounded-4 mb-4 d-flex align-items-center justify-content-between p-3">
          <div>
            <i class="bi bi-person-check-fill fs-5 me-2 text-primary"></i> <strong>Guest Checkout:</strong> No account required! Fill out your contact details below to complete your booking.
          </div>
          <a href="/login" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold text-nowrap ms-2">Log in</a>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h4 class="fw-bold mb-3">1. Guest & Contact Information</h4>
        <form action="/checkout/process" method="POST" id="checkout-form">
          <input type="hidden" name="tourId" value="<%= tour.id %>">
          <input type="hidden" name="scheduleId" value="<%= scheduleId || '' %>">
          <input type="hidden" name="departureDate" value="<%= departureDate %>">
          <input type="hidden" name="guestCount" value="<%= guestCount %>">
          <input type="hidden" name="couponCode" id="hidden-coupon-code" value="">

          <div class="row g-3 mb-4">
            <div class="col-12">
              <label class="form-label small fw-bold">Lead Contact Name</label>
              <input type="text" name="contactName" class="form-control" value="<%= user ? user.name : '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Email Address (for ticket PDF & confirmation)</label>
              <input type="email" name="contactEmail" class="form-control" value="<%= user ? user.email : '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Phone Number</label>
              <input type="text" name="contactPhone" class="form-control" value="<%= user ? user.phone || '' : '' %>" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Special Requests or Dietary Requirements (Optional)</label>
              <textarea name="specialRequests" class="form-control" rows="2"></textarea>
            </div>
          </div>

          <h4 class="fw-bold mb-3">2. Payment Method</h4>
          <div class="card p-3 border rounded-3 mb-4 bg-light">
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="paymentMethod" value="stripe" id="pay-stripe" checked>
              <label class="form-check-label fw-bold d-flex align-items-center gap-2" for="pay-stripe">
                <i class="bi bi-credit-card-2-front-fill text-primary fs-5"></i> Credit Card (Stripe Secured)
              </label>
            </div>
            <div class="ps-4">
              <small class="text-muted d-block mb-2">Safe, instant payment with SSL 256-bit encryption.</small>
              <div class="p-3 bg-white border rounded-3">
                <div class="row g-2">
                  <div class="col-12">
                    <input type="text" class="form-control form-control-sm" placeholder="Card Number (4242 4242 4242 4242)" value="4242 •••• •••• 4242">
                  </div>
                  <div class="col-6">
                    <input type="text" class="form-control form-control-sm" placeholder="MM / YY" value="12/28">
                  </div>
                  <div class="col-6">
                    <input type="text" class="form-control form-control-sm" placeholder="CVC" value="123">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-accent btn-lg w-100 py-3 rounded-pill fw-bold shadow-lg">
            <i class="bi bi-lock-fill me-2"></i> Complete Payment & Confirm Booking
          </button>
        </form>
      </div>
    </div>

    <!-- Right Order Summary Sidebar -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm p-4 rounded-4 sticky-top" style="top: 100px;">
        <h4 class="fw-bold mb-3">Booking Summary</h4>

        <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
          <img src="<%= tour.featuredImage %>" class="rounded-3" width="90" height="90" style="object-fit:cover;">
          <div>
            <h6 class="fw-bold mb-1"><%= tour.name %></h6>
            <div class="small text-muted"><i class="bi bi-clock me-1"></i> <%= tour.duration %></div>
            <div class="small text-muted"><i class="bi bi-calendar-event me-1"></i> Departs: <%= formatDate(departureDate) %></div>
          </div>
        </div>

        <!-- Coupon Input Box -->
        <div class="mb-4">
          <label class="form-label small fw-bold text-muted">Promo / Coupon Code</label>
          <div class="input-group">
            <input type="text" id="coupon-code-input" class="form-control text-uppercase" placeholder="e.g. WELCOME10">
            <button type="button" id="btn-apply-coupon" class="btn btn-primary fw-bold">Apply</button>
          </div>
        </div>

        <input type="hidden" id="checkout-total-amount" value="<%= totalAmount %>">

        <!-- Price Breakdown Table -->
        <div class="py-2 border-top">
          <div class="d-flex justify-content-between py-1">
            <span class="text-muted">Unit Price</span>
            <span>$<%= (tour.discountPrice || tour.price) %></span>
          </div>
          <div class="d-flex justify-content-between py-1">
            <span class="text-muted">Guests</span>
            <span><%= guestCount %></span>
          </div>
          <div class="d-flex justify-content-between py-1">
            <span class="text-muted">Subtotal</span>
            <span class="fw-bold">$<%= totalAmount.toFixed(2) %></span>
          </div>
          <div class="d-flex justify-content-between py-1 text-success d-none" id="checkout-discount-row">
            <span>Discount Coupon</span>
            <span class="fw-bold" id="checkout-discount-value">-$0.00</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between align-items-center">
            <span class="fs-5 fw-bold">Total Due</span>
            <span class="fs-3 fw-extrabold text-primary" id="checkout-final-total">$<%= totalAmount.toFixed(2) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
