<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0">Tour Categories Management</h4>
  <button class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#createCategoryModal"><i class="bi bi-plus-lg me-1"></i> Add New Category</button>
</div>

<% if (success) { %><div class="alert alert-success rounded-4 mb-4"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger rounded-4 mb-4"><%= error %></div><% } %>

<div class="card border-0 shadow-sm p-4 rounded-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Category Name</th>
          <th>Icon</th>
          <th>Slug</th>
          <th>Description</th>
          <th>Assigned Tours</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(c => { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <i class="<%= c.icon %> text-primary fs-4"></i>
                <span class="fw-bold"><%= c.name %></span>
              </div>
            </td>
            <td><code><%= c.icon %></code></td>
            <td><code><%= c.slug %></code></td>
            <td><%= c.description || 'N/A' %></td>
            <td><span class="badge bg-info text-dark"><%= c.tours ? c.tours.length : 0 %> Tour(s)</span></td>
            <td>
              <div class="d-flex gap-2">
                <a href="/admin/categories/<%= c.id %>/edit" class="btn btn-outline-primary btn-sm rounded-circle" title="Edit Category"><i class="bi bi-pencil"></i></a>
                <form action="/admin/categories/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this category?');">
                  <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Delete Category"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal for Create Category -->
<div class="modal fade" id="createCategoryModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4 border-0 p-3">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-grid-plus text-primary me-2"></i> Add Tour Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/categories/create" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Category Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Wildlife Safari" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">SEO URL Slug (Optional)</label>
            <input type="text" name="slug" class="form-control text-lowercase" placeholder="e.g. wildlife-safari (Leave empty to auto-generate)">
          </div>

          <!-- Visual Icon Picker -->
          <div class="mb-3">
            <label class="form-label small fw-bold">Select Category Icon</label>
            <div class="input-group mb-2">
              <span class="input-group-text bg-light"><i id="modalIconPreview" class="bi bi-compass-fill text-primary fs-5"></i></span>
              <input type="text" name="icon" id="modalIconInput" class="form-control" placeholder="bi bi-compass-fill" value="bi bi-compass-fill">
            </div>
            <div class="small text-muted mb-2">Click an icon below to select quickly, or type any custom Bootstrap icon class above:</div>
            
            <div id="modalIconGrid" class="d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border">
              <button type="button" class="btn btn-sm btn-primary text-white icon-btn" data-icon="bi bi-compass-fill" title="Compass"><i class="bi bi-compass-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-sun-fill" title="Beach / Sun"><i class="bi bi-sun-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-water" title="Island / Water"><i class="bi bi-water fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-tsunami" title="Adventure / Waves"><i class="bi bi-tsunami fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-tree-fill" title="Nature / Mountain"><i class="bi bi-tree-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-bank" title="Cultural / Heritage"><i class="bi bi-bank fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-ship-front-fill" title="Cruise / Yacht"><i class="bi bi-ship-front-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-anchor" title="Anchor"><i class="bi bi-anchor fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-backpack-fill" title="Trekking / Hiking"><i class="bi bi-backpack-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-airplane-engines-fill" title="Flight / Travel"><i class="bi bi-airplane-engines-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-building" title="City Tour"><i class="bi bi-building fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-star-fill" title="Luxury / Premium"><i class="bi bi-star-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-camera-reels-fill" title="Wildlife / Safari"><i class="bi bi-camera-reels-fill fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-bicycle" title="Cycling"><i class="bi bi-bicycle fs-5"></i></button>
              <button type="button" class="btn btn-sm btn-outline-secondary icon-btn" data-icon="bi bi-cup-hot-fill" title="Culinary / Food"><i class="bi bi-cup-hot-fill fs-5"></i></button>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Description</label>
            <textarea name="description" class="form-control" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Category Image (Optional)</label>
            <input type="file" name="image" class="form-control" accept="image/*">
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="submit" class="btn btn-primary rounded-pill px-4 w-100 fw-bold">Save Category</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const inputEl = document.getElementById('modalIconInput');
    const previewEl = document.getElementById('modalIconPreview');
    const gridEl = document.getElementById('modalIconGrid');

    if (inputEl && previewEl && gridEl) {
      inputEl.addEventListener('input', function() {
        previewEl.className = (this.value || 'bi bi-compass-fill') + ' text-primary fs-5';
      });

      const btns = gridEl.querySelectorAll('.icon-btn');
      btns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          btns.forEach(b => {
            b.classList.remove('btn-primary', 'text-white');
            b.classList.add('btn-outline-secondary');
          });
          this.classList.remove('btn-outline-secondary');
          this.classList.add('btn-primary', 'text-white');

          const val = this.getAttribute('data-icon');
          inputEl.value = val;
          previewEl.className = val + ' text-primary fs-5';
        });
      });
    }
  });
</script>
