<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0">Destinations Management</h4>
  <a href="/admin/destinations/create" class="btn btn-primary rounded-pill px-4 fw-bold"><i class="bi bi-plus-lg me-1"></i> Add Destination</a>
</div>

<% if (success) { %><div class="alert alert-success rounded-4 mb-4"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger rounded-4 mb-4"><%= error %></div><% } %>

<div class="card border-0 shadow-sm p-4 rounded-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Destination</th>
          <th>Country</th>
          <th>Slug</th>
          <th>Popular</th>
          <th>Created Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% destinations.forEach(d => { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-3">
                <img src="<%= d.banner %>" class="rounded-3" width="50" height="50" style="object-fit:cover;">
                <div>
                  <div class="fw-bold"><%= d.name %></div>
                </div>
              </div>
            </td>
            <td><%= d.country || 'N/A' %></td>
            <td><code><%= d.slug %></code></td>
            <td><span class="badge bg-<%= d.isPopular ? 'primary' : 'secondary' %>"><%= d.isPopular ? 'Yes' : 'No' %></span></td>
            <td><%= formatDate(d.createdAt) %></td>
            <td>
              <div class="d-flex gap-2">
                <a href="/admin/destinations/<%= d.id %>/edit" class="btn btn-outline-primary btn-sm rounded-circle" title="Edit Destination"><i class="bi bi-pencil"></i></a>
                <form action="/admin/destinations/<%= d.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this destination?');">
                  <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Delete Destination"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
