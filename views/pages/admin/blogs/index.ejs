<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0">Blog Articles Management</h4>
  <a href="/admin/blogs/create" class="btn btn-primary rounded-pill px-4 fw-bold">
    <i class="bi bi-plus-lg me-1"></i> Create New Blog Article
  </a>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success rounded-4 mb-4"><%= success %></div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger rounded-4 mb-4"><%= error %></div>
<% } %>

<div class="card border-0 shadow-sm p-4 rounded-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Article</th>
          <th>Category</th>
          <th>Author</th>
          <th>Views</th>
          <th>Status</th>
          <th>Created Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (blogs && blogs.length > 0) { %>
          <% blogs.forEach(blog => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= blog.featuredImage %>" class="rounded-3 border" width="70" height="50" style="object-fit:cover;">
                  <div>
                    <h6 class="fw-bold mb-0 text-truncate" style="max-width: 280px;" title="<%= blog.title %>"><%= blog.title %></h6>
                    <small class="text-muted"><code>/blog/<%= blog.slug %></code></small>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2">
                  <%= blog.category ? blog.category.name : 'General' %>
                </span>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <img src="<%= blog.author && blog.author.avatar ? blog.author.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80' %>" class="rounded-circle" width="28" height="28" style="object-fit:cover;">
                  <span class="small fw-bold"><%= blog.author ? blog.author.name : 'Admin' %></span>
                </div>
              </td>
              <td>
                <span class="badge bg-light text-dark border">
                  <i class="bi bi-eye-fill text-muted me-1"></i><%= blog.viewsCount || 0 %>
                </span>
              </td>
              <td>
                <% if (blog.isPublished) { %>
                  <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Published</span>
                <% } else { %>
                  <span class="badge bg-secondary px-3 py-2"><i class="bi bi-pencil-square me-1"></i> Draft</span>
                <% } %>
              </td>
              <td class="small text-muted"><%= formatDate(blog.createdAt) %></td>
              <td>
                <div class="d-flex gap-2">
                  <a href="/blog/<%= blog.slug %>" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="Preview Article">
                    <i class="bi bi-box-arrow-up-right"></i>
                  </a>
                  <a href="/admin/blogs/<%= blog.id %>/edit" class="btn btn-outline-primary btn-sm rounded-circle" title="Edit Article">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/admin/blogs/<%= blog.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this blog article?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Delete Article">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              No blog articles found. Click "Create New Blog Article" to add your first post!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
