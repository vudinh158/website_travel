<div class="card border-0 shadow-sm p-4 rounded-4" style="max-width: 900px;">
  <h4 class="fw-bold mb-4"><i class="bi bi-pencil-square text-primary me-2"></i> Edit Blog Article</h4>
  
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger rounded-4 mb-4"><%= error %></div>
  <% } %>

  <form action="/admin/blogs/<%= blog.id %>/edit" method="POST" enctype="multipart/form-data">
    <div class="row g-3 mb-4">
      <div class="col-md-8">
        <label class="form-label small fw-bold">Article Title</label>
        <input type="text" name="title" class="form-control form-control-lg" value="<%= blog.title %>" required>
      </div>
      
      <div class="col-md-4">
        <label class="form-label small fw-bold">Category</label>
        <select name="categoryId" class="form-select form-select-lg" required>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= blog.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          <% } else { %>
            <option value="1">Travel Guides</option>
          <% } %>
        </select>
      </div>

      <div class="col-12">
        <label class="form-label small fw-bold">SEO URL Slug</label>
        <input type="text" name="slug" class="form-control text-lowercase" value="<%= blog.slug %>" required>
        <small class="text-muted">Clean URL for SEO. E.g: <code>/blog/<%= blog.slug %></code></small>
      </div>

      <div class="col-12">
        <label class="form-label small fw-bold">Current Featured Header Image</label>
        <div class="mb-2">
          <img src="<%= blog.featuredImage %>" class="rounded-3 border" width="200" height="110" style="object-fit:cover;">
        </div>
        <label class="form-label small fw-bold">Change Image (Optional)</label>
        <input type="file" name="featuredImage" class="form-control" accept="image/*">
      </div>

      <div class="col-12">
        <label class="form-label small fw-bold">Short Excerpt / Summary</label>
        <textarea name="excerpt" class="form-control" rows="2"><%= blog.excerpt || '' %></textarea>
      </div>

      <div class="col-12">
        <label class="form-label small fw-bold">Article Main Content</label>
        <textarea name="content" class="form-control" rows="14" required><%= blog.content %></textarea>
      </div>

      <!-- SEO Meta Fields -->
      <div class="col-12 border-top pt-4">
        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-search me-2"></i> SEO Meta Information</h5>
      </div>

      <div class="col-12">
        <label class="form-label small fw-bold">SEO Title</label>
        <input type="text" name="metaTitle" class="form-control" value="<%= blog.metaTitle || '' %>">
      </div>

      <div class="col-12">
        <label class="form-label small fw-bold">SEO Meta Description</label>
        <textarea name="metaDescription" class="form-control" rows="2"><%= blog.metaDescription || '' %></textarea>
      </div>

      <div class="col-12 border-top pt-3">
        <div class="form-check form-switch mt-2">
          <input class="form-check-input" type="checkbox" name="isPublished" id="isPublished" <%= blog.isPublished ? 'checked' : '' %>>
          <label class="form-check-label fw-bold" for="isPublished">Published to live website</label>
        </div>
      </div>
    </div>

    <div class="d-flex gap-3">
      <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">Update Blog Article</button>
      <a href="/admin/blogs" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
    </div>
  </form>
</div>
