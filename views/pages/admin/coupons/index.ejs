<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0">Discount Coupons Management</h4>
  <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createCouponModal"><i class="bi bi-plus-lg me-1"></i> Create Coupon</button>
</div>

<% if (success) { %><div class="alert alert-success rounded-4 mb-4"><%= success %></div><% } %>

<div class="card border-0 shadow-sm p-4 rounded-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Code</th>
          <th>Type</th>
          <th>Value</th>
          <th>Min Amount</th>
          <th>Expiry Date</th>
          <th>Times Used</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% coupons.forEach(c => { %>
          <tr>
            <td class="fw-bold text-primary"><%= c.code %></td>
            <td><%= c.discountType %></td>
            <td><%= c.discountType === 'percentage' ? c.discountValue + '%' : '$' + c.discountValue %></td>
            <td>$<%= c.minBookingAmount %></td>
            <td><%= formatDate(c.expiresAt) %></td>
            <td><%= c.timesUsed %></td>
            <td><span class="badge bg-<%= c.isActive ? 'success' : 'secondary' %>"><%= c.isActive ? 'Active' : 'Inactive' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal for Create Coupon -->
<div class="modal fade" id="createCouponModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4 border-0 p-3">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Create Coupon</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/coupons/create" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Coupon Code</label>
            <input type="text" name="code" class="form-control text-uppercase" placeholder="SUMMER50" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Discount Type</label>
            <select name="discountType" class="form-select">
              <option value="percentage">Percentage (%)</option>
              <option value="fixed">Fixed Amount ($)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Discount Value</label>
            <input type="number" step="0.01" name="discountValue" class="form-control" placeholder="10.00" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Minimum Booking Subtotal ($)</label>
            <input type="number" step="0.01" name="minBookingAmount" class="form-control" value="0.00">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Expiry Date</label>
            <input type="date" name="expiresAt" class="form-control" required>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="submit" class="btn btn-primary rounded-pill px-4 w-100 fw-bold">Create Coupon</button>
        </div>
      </form>
    </div>
  </div>
</div>
