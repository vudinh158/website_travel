<div class="bg-primary text-white py-5 mb-5">
  <div class="container text-center">
    <h1 class="display-4 fw-extrabold mb-2">Get In Touch</h1>
    <p class="fs-5 opacity-90 mb-0">Our 24/7 travel specialists are here to help you plan your next tour.</p>
  </div>
</div>

<div class="container mb-5">
  <% if (success) { %>
    <div class="alert alert-success rounded-4 mb-4"><%= success %></div>
  <% } %>

  <div class="row g-5">
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm p-4 rounded-4 h-100">
        <h4 class="fw-bold mb-4">Contact Information</h4>
        <div class="d-flex align-items-center gap-3 mb-4">
          <i class="bi bi-geo-alt-fill text-danger fs-3"></i>
          <div>
            <div class="fw-bold">Headquarters Address</div>
            <div class="text-muted small">100 Ocean Drive, Suite 500, Miami, FL 33139</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-3 mb-4">
          <i class="bi bi-telephone-fill text-primary fs-3"></i>
          <div>
            <div class="fw-bold">Phone Hotline</div>
            <div class="text-muted small">+1 (800) 555-WANDER</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-3 mb-4">
          <i class="bi bi-envelope-fill text-success fs-3"></i>
          <div>
            <div class="fw-bold">Email Support</div>
            <div class="text-muted small">support@wanderlust.com</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card border-0 shadow-sm p-4 rounded-4">
        <h4 class="fw-bold mb-4">Send Us a Message</h4>
        <form action="/contact" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold">Your Full Name</label>
              <input type="text" name="name" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Email Address</label>
              <input type="email" name="email" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Phone Number</label>
              <input type="text" name="phone" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Subject</label>
              <input type="text" name="subject" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Your Message</label>
              <textarea name="message" class="form-control" rows="5" required></textarea>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-wanderlust btn-lg w-100 rounded-pill fw-bold">Send Message</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
