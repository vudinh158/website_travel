<div class="container py-5 text-center" style="max-width: 700px;">
  <div class="card border-0 shadow-lg p-5 rounded-4">
    <div class="mb-4">
      <i class="bi bi-check-circle-fill display-1 text-success"></i>
    </div>
    <h2 class="fw-extrabold mb-2">Booking Confirmed!</h2>
    <p class="text-muted fs-5 mb-4">Thank you for booking with WanderLust. A confirmation email with your ticket details has been sent to <strong><%= booking.contactEmail %></strong>.</p>

    <div class="bg-light p-4 rounded-4 text-start mb-4">
      <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Booking Reference Code:</span>
        <span class="fw-bold text-primary fs-5"><%= booking.bookingCode %></span>
      </div>
      <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Tour Package:</span>
        <span class="fw-bold"><%= booking.tour ? booking.tour.name : 'Tour' %></span>
      </div>
      <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Departure Date:</span>
        <span class="fw-bold"><%= formatDate(booking.departureDate) %></span>
      </div>
      <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Guests:</span>
        <span class="fw-bold"><%= booking.guestCount %></span>
      </div>
      <div class="d-flex justify-content-between">
        <span class="text-muted">Total Paid:</span>
        <span class="fw-extrabold text-success fs-5">$<%= booking.finalAmount %></span>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-3 justify-content-center">
      <a href="/dashboard/bookings" class="btn btn-wanderlust btn-lg rounded-pill px-4">View My Bookings</a>
      <a href="/" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Return Home</a>
    </div>
  </div>
</div>
