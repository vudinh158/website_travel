<!-- Guide Detail Header Banner -->
<div class="position-relative text-white mb-5" style="min-height: 380px; background: linear-gradient(rgba(0, 45, 107, 0.75), rgba(0, 45, 107, 0.9)), url('<%= guide.heroImage %>') center/cover no-repeat; display: flex; align-items: flex-end;">
  <div class="container py-5">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/guides" class="text-white-50 text-decoration-none">Travel Guides</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page"><%= guide.title %></li>
      </ol>
    </nav>
    <div class="d-flex gap-2 mb-2">
      <span class="badge bg-accent text-white px-3 py-1.5 rounded-pill fw-bold text-uppercase"><%= guide.category %></span>
      <span class="badge bg-white text-dark px-3 py-1.5 rounded-pill"><i class="bi bi-clock me-1"></i> <%= guide.readTime %></span>
    </div>
    <h1 class="display-4 fw-extrabold text-white mb-2"><%= guide.title %></h1>
    <p class="fs-5 text-white-50 max-w-2xl mb-0" style="max-width: 780px;"><%= guide.excerpt %></p>
  </div>
</div>

<div class="container mb-5">
  <div class="row g-5">
    <!-- Main Guide Content Column -->
    <div class="col-lg-8">
      <div class="bg-white p-4 p-lg-5 rounded-4 shadow-sm mb-5">
        <div class="fs-6 text-secondary leading-relaxed guide-body-content">
          <%- guide.body.replace(/### (.*?)\n/g, '<h4 class="fw-bold text-primary mt-4 mb-3">$1</h4>').replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>') %>
        </div>

        <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
              <i class="bi bi-pen fs-5"></i>
            </div>
            <div>
              <span class="fw-bold text-dark d-block">Tranoi Travel Editorial Desk</span>
              <span class="text-muted small">Updated for 2026 &bull; Verified Vietnam Travel Specialists</span>
            </div>
          </div>
          <a href="/guides" class="btn btn-outline-primary rounded-pill px-3 fw-bold small">
            All Guides &rarr;
          </a>
        </div>
      </div>

      <!-- Featured Tours Banner -->
      <% if (featuredTours && featuredTours.length > 0) { %>
        <div class="mb-5">
          <h4 class="fw-bold text-dark mb-3">Tours Applying These Insights</h4>
          <div class="row g-4">
            <% featuredTours.forEach(tour => { %>
              <div class="col-md-6">
                <%- include('../partials/tour_card', { tour: tour }) %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Sidebar Column -->
    <div class="col-lg-4">
      <!-- Other Guides -->
      <% if (otherGuides && otherGuides.length > 0) { %>
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
          <h5 class="fw-bold text-primary mb-3">Related Guides</h5>
          <div class="d-flex flex-column gap-3">
            <% otherGuides.forEach(og => { %>
              <a href="/guides/<%= og.slug %>" class="text-decoration-none">
                <div class="p-3 rounded-3 bg-light hover-lift transition-smooth border">
                  <span class="badge bg-white text-primary border mb-1" style="font-size: 0.7rem;"><%= og.category %></span>
                  <h6 class="fw-bold text-dark mb-1"><%= og.title %></h6>
                  <span class="text-muted small"><i class="bi bi-clock me-1"></i> <%= og.readTime %> &bull; Read &rarr;</span>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Need Help Planning -->
      <div class="card border-0 rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #004AAD 0%, #002d6b 100%);">
        <h5 class="fw-bold text-white mb-2">Have Visa or Timing Questions?</h5>
        <p class="small text-white-50 mb-3">Our team checks your entry requirements and matches your travel dates with optimal weather.</p>
        <a href="/contact" class="btn btn-accent w-100 rounded-pill fw-bold text-white">
          Ask Our Specialists
        </a>
      </div>
    </div>
  </div>
</div>
