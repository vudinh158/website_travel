<div class="container py-5">
  <h3 class="fw-extrabold mb-4"><i class="bi bi-ticket-perforated-fill text-primary me-2"></i> My Booking History</h3>

  <% if (bookings.length === 0) { %>
    <div class="card border-0 shadow-sm p-5 text-center rounded-4">
      <i class="bi bi-ticket-perforated fs-1 text-muted mb-2"></i>
      <h4>No Bookings Found</h4>
      <p class="text-muted">You have no active or previous tour reservations.</p>
      <a href="/tours" class="btn btn-wanderlust w-auto mx-auto rounded-pill px-4">Explore Tours</a>
    </div>
  <% } else { %>
    <div class="d-flex flex-column gap-4">
      <% bookings.forEach(b => { %>
        <div class="card border-0 shadow-sm p-4 rounded-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom">
            <div>
              <span class="badge bg-light text-primary border mb-1">Booking Code: <%= b.bookingCode %></span>
              <h5 class="fw-bold mb-0"><%= b.tour ? b.tour.name : 'Tour Package' %></h5>
            </div>
            <div class="text-end">
              <span class="badge bg-<%= b.bookingStatus === 'confirmed' ? 'success' : b.bookingStatus === 'cancelled' ? 'danger' : 'warning' %> px-3 py-2 fs-6">
                <%= b.bookingStatus.toUpperCase() %>
              </span>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-3">
              <small class="text-muted d-block">Departure Date</small>
              <span class="fw-bold"><%= formatDate(b.departureDate) %></span>
            </div>
            <div class="col-md-3">
              <small class="text-muted d-block">Guests</small>
              <span class="fw-bold"><%= b.guestCount %> Guest(s)</span>
            </div>
            <div class="col-md-3">
              <small class="text-muted d-block">Total Amount</small>
              <span class="fw-extrabold text-primary fs-5">$<%= b.finalAmount %></span>
            </div>
            <div class="col-md-3 text-md-end">
              <% if (b.bookingStatus === 'confirmed') { %>
                <button class="btn btn-outline-danger btn-sm rounded-pill btn-cancel-booking" data-booking-id="<%= b.id %>">
                  Cancel Booking
                </button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  document.querySelectorAll('.btn-cancel-booking').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to cancel this booking?')) return;
      const id = btn.getAttribute('data-booking-id');

      try {
        const res = await fetch(`/dashboard/bookings/${id}/cancel`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert(data.message);
        }
      } catch (err) {
        alert('Failed to cancel booking.');
      }
    });
  });
</script>
