<div class="container py-5">
  <% if (welcome) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
      <strong>Welcome to Tranoi Travel!</strong> Your account has been registered successfully. Explore our tours or manage your bookings below.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="d-flex align-items-center gap-3 mb-4">
    <img src="<%= user.avatar %>" class="rounded-circle border" width="60" height="60" style="object-fit:cover;">
    <div>
      <h3 class="fw-extrabold mb-0">Welcome, <%= user.name %>!</h3>
      <p class="text-muted small mb-0"><%= user.email %> • Customer Account</p>
    </div>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm p-4 rounded-4 bg-primary text-white">
        <h6 class="fw-bold mb-1 opacity-75">Total Tour Bookings</h6>
        <h2 class="fw-extrabold mb-0"><%= totalBookingsCount %></h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm p-4 rounded-4 bg-white border">
        <h6 class="fw-bold mb-1 text-muted">Saved Wishlist Tours</h6>
        <h2 class="fw-extrabold text-danger mb-0"><%= wishlistCount %></h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm p-4 rounded-4 bg-white border">
        <h6 class="fw-bold mb-1 text-muted">Account Status</h6>
        <h2 class="fw-extrabold text-success mb-0"><i class="bi bi-patch-check-fill me-1"></i> Active</h2>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm p-4 rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Recent Bookings</h4>
      <a href="/dashboard/bookings" class="btn btn-sm btn-outline-primary rounded-pill">View All Bookings</a>
    </div>

    <% if (bookings.length === 0) { %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-ticket-perforated fs-1 mb-2 d-block"></i>
        <p class="mb-2">You haven't booked any tours yet.</p>
        <a href="/tours" class="btn btn-wanderlust btn-sm rounded-pill px-3">Browse Available Tours</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Booking Code</th>
              <th>Tour Package</th>
              <th>Departure Date</th>
              <th>Guests</th>
              <th>Total Paid</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b => { %>
              <tr>
                <td class="fw-bold text-primary"><%= b.bookingCode %></td>
                <td><%= b.tour ? b.tour.name : 'Tour Package' %></td>
                <td><%= formatDate(b.departureDate) %></td>
                <td><%= b.guestCount %></td>
                <td class="fw-bold">$<%= b.finalAmount %></td>
                <td>
                  <span class="badge bg-<%= b.bookingStatus === 'confirmed' ? 'success' : b.bookingStatus === 'cancelled' ? 'danger' : 'warning' %>">
                    <%= b.bookingStatus %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
