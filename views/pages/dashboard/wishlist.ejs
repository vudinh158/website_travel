<div class="container py-5">
  <h3 class="fw-extrabold mb-4"><i class="bi bi-heart-fill text-danger me-2"></i> My Saved Wishlist</h3>

  <% if (wishlistItems.length === 0) { %>
    <div class="card border-0 shadow-sm p-5 text-center rounded-4">
      <i class="bi bi-heart fs-1 text-muted mb-2"></i>
      <h4>Your Wishlist is Empty</h4>
      <p class="text-muted">Explore tours and click the heart icon to save your favorite destinations.</p>
      <a href="/tours" class="btn btn-wanderlust w-auto mx-auto rounded-pill px-4">Browse Tours</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% wishlistItems.forEach(item => { %>
        <% if (item.tour) { %>
          <div class="col-md-4">
            <%- include('../../../partials/tour_card', { tour: item.tour }) %>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>
</div>
