<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
        <h3 class="fw-extrabold mb-2">Forgot Password?</h3>
        <p class="text-muted small mb-4">Enter your account email and we'll send a password reset link.</p>

        <% if (error) { %><div class="alert alert-danger rounded-3 small"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success rounded-3 small"><%= success %></div><% } %>

        <form action="/forgot-password" method="POST">
          <div class="mb-4">
            <label class="form-label small fw-bold">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="name@example.com" required>
          </div>
          <button type="submit" class="btn btn-wanderlust btn-lg w-100 rounded-pill fw-bold">Send Reset Link</button>
        </form>
        <div class="text-center mt-3"><a href="/login" class="small text-decoration-none">Back to Login</a></div>
      </div>
    </div>
  </div>
</div>
