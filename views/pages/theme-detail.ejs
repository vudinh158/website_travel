<!-- Theme Detail Header Banner -->
<div class="position-relative text-white mb-5" style="min-height: 400px; background: linear-gradient(rgba(0, 45, 107, 0.75), rgba(0, 45, 107, 0.9)), url('<%= theme.heroImage %>') center/cover no-repeat; display: flex; align-items: flex-end;">
  <div class="container py-5">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page"><%= theme.title %></li>
      </ol>
    </nav>
    <span class="badge bg-accent text-white px-3 py-1.5 rounded-pill fw-bold text-uppercase mb-2">
      <%= theme.type === 'source-market' ? 'Source Market' : 'Travel Theme' %>
    </span>
    <h1 class="display-4 fw-extrabold text-white mb-2"><%= theme.title %></h1>
    <p class="fs-5 text-white-50 max-w-2xl mb-0" style="max-width: 780px;"><%= theme.tagline %></p>
  </div>
</div>

<div class="container mb-5">
  <div class="row g-5">
    <!-- Main Editorial Article Column (500-800 words) -->
    <div class="col-lg-8">
      <div class="bg-white p-4 p-lg-5 rounded-4 shadow-sm mb-5">
        <h3 class="fw-bold text-primary mb-4">Editorial Perspective &amp; Trip Design</h3>
        <div class="fs-6 text-secondary leading-relaxed mb-4">
          <%- theme.body.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>') %>
        </div>
        
        <div class="p-3 bg-light rounded-3 border-start border-4 border-primary">
          <span class="fw-bold text-dark d-block mb-1">Our Vietnam Commitment</span>
          <span class="small text-muted">Every itinerary featured below is fully refined by our local operations team in Hanoi and Saigon, guaranteeing transparent pricing and 24/7 on-ground care.</span>
        </div>
      </div>

      <!-- Naturally Linked Tours (2-4 Matching Tours per Sitemap Section 6) -->
      <% if (matchingTours && matchingTours.length > 0) { %>
        <div class="mb-5">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-dark mb-0">Recommended Tours Matching This Theme</h3>
            <a href="/tours" class="text-primary fw-bold text-decoration-none small">View all tours &rarr;</a>
          </div>
          <div class="row g-4">
            <% matchingTours.forEach(tour => { %>
              <div class="col-md-6">
                <%- include('../partials/tour_card', { tour: tour }) %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Related Blogs & Travel Guides for this Theme -->
      <% if (typeof relatedArticles !== 'undefined' && relatedArticles && relatedArticles.length > 0) { %>
        <div class="mb-5">
          <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
              <span class="text-accent text-uppercase fw-bold small tracking-wider d-block mb-1">INSPIRATION &amp; FIELD ADVICE</span>
              <h3 class="fw-bold text-dark mb-0">Related Guides &amp; Route Stories</h3>
            </div>
            <a href="/guides" class="text-primary fw-bold text-decoration-none small">View all guides &rarr;</a>
          </div>
          <div class="row g-4">
            <% relatedArticles.forEach(article => { %>
              <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift transition-smooth bg-white">
                  <div class="position-relative" style="height: 180px;">
                    <img src="<%= article.image %>" alt="<%= article.title %>" class="w-100 h-100" style="object-fit: cover;" loading="lazy">
                    <span class="position-absolute top-0 start-0 m-3 badge <%= article.badgeClass %> text-white rounded-pill px-2.5 py-1 small fw-bold shadow-sm">
                      <%= article.typeBadge %>
                    </span>
                    <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.75rem;">
                      <i class="bi bi-clock me-1"></i><%= article.readTime %>
                    </span>
                  </div>
                  <div class="card-body p-4 d-flex flex-column">
                    <span class="text-muted small fw-semibold mb-1"><%= article.category %></span>
                    <h5 class="fw-bold text-dark mb-2">
                      <a href="<%= article.url %>" class="text-dark text-decoration-none hover-primary">
                        <%= article.title %>
                      </a>
                    </h5>
                    <p class="text-secondary small mb-3 flex-grow-1">
                      <%= article.excerpt %>
                    </p>
                    <div class="pt-2 border-top">
                      <a href="<%= article.url %>" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3">
                        Read Story <i class="bi bi-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Sidebar Column: Other Themes & Consultation -->
    <div class="col-lg-4">
      <!-- Related Themes -->
      <% if (otherThemes && otherThemes.length > 0) { %>
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
          <h5 class="fw-bold text-primary mb-3">Other Curated Themes</h5>
          <div class="d-flex flex-column gap-3">
            <% otherThemes.forEach(ot => { %>
              <a href="/<%= ot.slug %>" class="text-decoration-none">
                <div class="p-3 rounded-3 bg-light hover-lift transition-smooth border">
                  <span class="badge bg-white text-primary border mb-1" style="font-size: 0.7rem;"><%= ot.type %></span>
                  <h6 class="fw-bold text-dark mb-1"><%= ot.title %></h6>
                  <span class="text-muted small">Read editorial article &rarr;</span>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Tailored Trip Request -->
      <div class="card border-0 rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #004AAD 0%, #002d6b 100%);">
        <h5 class="fw-bold text-white mb-2">Have a Question?</h5>
        <p class="small text-white-50 mb-3">Our Vietnam destination specialists are ready to help tailor your trip to your exact dates and party size.</p>
        <a href="/contact" class="btn btn-accent w-100 rounded-pill fw-bold text-white">
          Inquire With Our Team
        </a>
      </div>
    </div>
  </div>
</div>
