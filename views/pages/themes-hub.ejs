<!-- Themes Hub Header -->
<div class="bg-primary text-white py-5 mb-5" style="background: linear-gradient(135deg, #004AAD 0%, #002d6b 100%);">
  <div class="container py-3">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page">Travel Themes</li>
      </ol>
    </nav>
    <span class="badge bg-accent text-white px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">Editorial Collections</span>
    <h1 class="display-4 fw-extrabold text-white mb-2">Vietnam Travel Themes &amp; Origin Markets</h1>
    <p class="fs-5 text-white-50 mb-0" style="max-width: 720px;">
      Explore our hand-crafted editorial themes. Written by local specialists to match specific traveler types and international flight gateways.
    </p>
  </div>
</div>

<div class="container mb-5">
  <!-- Traveler Styles (P1 & P2) -->
  <div class="mb-5 pb-4 border-bottom">
    <div class="mb-4">
      <span class="text-accent text-uppercase fw-bold small tracking-wider">Curated by Style</span>
      <h2 class="fw-extrabold text-dark mb-1">Traveler Types &amp; Special Interests</h2>
    </div>
    <div class="row g-4">
      <% travelerThemes.forEach(theme => { %>
        <div class="col-lg-4 col-md-6">
          <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden bg-white hover-lift transition-smooth">
            <div style="height: 200px;" class="position-relative">
              <img src="<%= theme.heroImage %>" alt="<%= theme.title %>" class="w-100 h-100" style="object-fit: cover;">
              <span class="position-absolute top-0 start-0 m-3 badge bg-primary text-white rounded-pill px-3 py-1">Theme</span>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <h4 class="fw-bold mb-2">
                  <a href="/<%= theme.slug %>" class="text-dark text-decoration-none hover-primary">
                    <%= theme.title %>
                  </a>
                </h4>
                <p class="text-secondary small leading-relaxed mb-3">
                  <%= truncateText(theme.tagline || theme.body, 120) %>
                </p>
              </div>
              <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Editorial Article</span>
                <a href="/<%= theme.slug %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                  Read Theme &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Origin Markets (P1 Source Markets) -->
  <div class="mb-5">
    <div class="mb-4">
      <span class="text-accent text-uppercase fw-bold small tracking-wider">Curated by Gateway</span>
      <h2 class="fw-extrabold text-dark mb-1">Tours by International Departure Market</h2>
      <p class="text-muted mb-0">Specially coordinated for flight timings, jet lag recovery, and regional traveler preferences.</p>
    </div>
    <div class="row g-4">
      <% marketThemes.forEach(theme => { %>
        <div class="col-lg-4 col-md-6">
          <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden bg-white hover-lift transition-smooth">
            <div style="height: 200px;" class="position-relative">
              <img src="<%= theme.heroImage %>" alt="<%= theme.title %>" class="w-100 h-100" style="object-fit: cover;">
              <span class="position-absolute top-0 start-0 m-3 badge bg-accent text-white rounded-pill px-3 py-1">Departure Market</span>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <h4 class="fw-bold mb-2">
                  <a href="/<%= theme.slug %>" class="text-dark text-decoration-none hover-primary">
                    <%= theme.title %>
                  </a>
                </h4>
                <p class="text-secondary small leading-relaxed mb-3">
                  <%= truncateText(theme.tagline || theme.body, 120) %>
                </p>
              </div>
              <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Specialized Planning</span>
                <a href="/<%= theme.slug %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                  Explore Details &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
