<!-- Hero Banner with 3D Motion & Interactive Floating Cards -->
<div class="hero-wrapper text-white mb-5 perspective-container">
  <div class="container py-5">
    <div class="row align-items-center">
      <div class="col-lg-7 mb-4 mb-lg-0 reveal-left active">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3 text-uppercase tracking-wider animate-float-3d d-inline-flex align-items-center gap-1 shadow-lg">
          <i class="bi bi-stars me-1 text-danger fs-6"></i> #1 Premier 3D Interactive Tour Platform
        </span>
        <h1 class="display-3 fw-extrabold text-white mb-3 layer-3d-lift">
          Explore The World's Most Extraordinary Tours
        </h1>
        <p class="fs-5 text-light opacity-90 mb-4 me-lg-5 layer-3d-lift">
          Handcrafted expeditions, tropical paradises, and mountain treks. Book your next unforgettable journey with expert guides and 24/7 support.
        </p>
        <div class="d-flex flex-wrap gap-3 layer-3d-deep">
          <a href="/tours" class="btn btn-wanderlust btn-lg px-4 py-3 rounded-pill shadow-lg">
            Explore All Tours <i class="bi bi-compass ms-2"></i>
          </a>
          <a href="/destinations" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill">
            View Destinations
          </a>
        </div>
      </div>

      <!-- Quick Tour Search Card with 3D Glassmorphism & Interactive Mouse Tilt -->
      <div class="col-lg-5 reveal-right active">
        <div class="hero-3d-glass text-dark card-3d-tilt">
          <div class="layer-3d-lift">
            <h4 class="fw-bold mb-3 text-primary"><i class="bi bi-search me-2"></i> Find Your Perfect Tour</h4>
            <form action="/tours" method="GET" class="d-flex flex-column gap-3">
              <div>
                <label class="form-label small fw-bold text-muted">Destination</label>
                <select name="destination" class="form-select shadow-sm">
                  <option value="">All Destinations</option>
                  <% popularDestinations.forEach(dest => { %>
                    <option value="<%= dest.slug %>"><%= dest.name %></option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label class="form-label small fw-bold text-muted">Tour Category</label>
                <select name="category" class="form-select shadow-sm">
                  <option value="">All Categories</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.slug %>"><%= cat.name %></option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label class="form-label small fw-bold text-muted">Duration</label>
                <select name="duration" class="form-select shadow-sm">
                  <option value="">Any Duration</option>
                  <option value="short">1 - 3 Days</option>
                  <option value="medium">4 - 7 Days</option>
                  <option value="long">8+ Days</option>
                </select>
              </div>

              <button type="submit" class="btn btn-accent pulse-glow w-100 py-3 rounded-pill fs-6 mt-2 layer-3d-deep shadow-lg">
                <i class="bi bi-search me-2"></i> Search Available Tours
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Animated Travel Statistics Counter with 3D Depth Card -->
<div class="container mb-5 reveal-zoom perspective-container">
  <div class="row g-4 text-center bg-white p-4 rounded-4 shadow-sm border card-3d-tilt">
    <div class="col-md-3 col-6 layer-3d-lift">
      <h2 class="fw-extrabold text-primary display-5 mb-0 counter-value" data-target="150" data-suffix="+">0</h2>
      <p class="text-muted mb-0 fw-semibold">Curated Tour Packages</p>
    </div>
    <div class="col-md-3 col-6 layer-3d-lift">
      <h2 class="fw-extrabold text-primary display-5 mb-0 counter-value" data-target="45" data-suffix="k+">0</h2>
      <p class="text-muted mb-0 fw-semibold">Happy Travelers</p>
    </div>
    <div class="col-md-3 col-6 layer-3d-lift">
      <h2 class="fw-extrabold text-primary display-5 mb-0 counter-value" data-target="4.9" data-suffix="/5" data-decimals="1">0</h2>
      <p class="text-muted mb-0 fw-semibold">Customer Rating</p>
    </div>
    <div class="col-md-3 col-6 layer-3d-lift">
      <h2 class="fw-extrabold text-primary display-5 mb-0 counter-value" data-target="100" data-suffix="%">0</h2>
      <p class="text-muted mb-0 fw-semibold">Satisfaction Guarantee</p>
    </div>
  </div>
</div>

<!-- Popular Destinations -->
<section class="container mb-5 reveal-up perspective-container">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <span class="text-primary fw-bold text-uppercase small">Top Destinations</span>
      <h2 class="fw-extrabold mb-0">Popular Travel Spots</h2>
    </div>
    <a href="/destinations" class="btn btn-outline-primary rounded-pill">View All Destinations <i class="bi bi-arrow-right ms-1"></i></a>
  </div>
  <div class="row g-4">
    <% popularDestinations.forEach((dest, i) => { %>
      <div class="col-md-4 col-sm-6 reveal-up delay-<%= (i%3)+1 %>">
        <%- include('../../partials/destination_card', { destination: dest }) %>
      </div>
    <% }) %>
  </div>
</section>

<!-- Featured Tours Section -->
<section class="container mb-5 reveal-up perspective-container">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <span class="text-primary fw-bold text-uppercase small">Featured Packages</span>
      <h2 class="fw-extrabold mb-0">Best Selling Tour Expeditions</h2>
    </div>
    <a href="/tours" class="btn btn-outline-primary rounded-pill">Explore All Tours <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <div class="row g-4">
    <% featuredTours.forEach((tour, i) => { %>
      <div class="col-lg-4 col-md-6 reveal-up delay-<%= (i%3)+1 %>">
        <%- include('../../partials/tour_card', { tour: tour }) %>
      </div>
    <% }) %>
  </div>
</section>

<!-- Special Promotions Animated Shimmer Banner -->
<section class="container mb-5 reveal-zoom perspective-container">
  <div class="p-5 rounded-4 text-white position-relative overflow-hidden promo-shimmer shadow-lg card-3d-tilt">
    <div class="row align-items-center relative z-1 layer-3d-lift">
      <div class="col-lg-8">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 animate-float-3d">Limited Time Promo</span>
        <h2 class="display-5 fw-extrabold mb-3">Get 10% Off Your First Tour Booking!</h2>
        <p class="fs-5 opacity-90 mb-4">Use promotional code <strong class="text-warning">WELCOME10</strong> at checkout and enjoy instant savings on your adventure.</p>
        <a href="/tours" class="btn btn-warning text-dark font-extrabold btn-lg px-4 rounded-pill pulse-glow layer-3d-deep shadow-lg">Book & Save Now</a>
      </div>
    </div>
  </div>
</section>

<!-- Customer Reviews Section -->
<section class="bg-light py-5 mb-5 border-top border-bottom">
  <div class="container reveal-up perspective-container">
    <div class="text-center max-w-2xl mx-auto mb-5">
      <span class="text-primary fw-bold text-uppercase small">Testimonials</span>
      <h2 class="fw-extrabold">What Our Travelers Say</h2>
    </div>
    <div class="row g-4">
      <% customerReviews.forEach((rev, i) => { %>
        <div class="col-md-4 reveal-up delay-<%= (i%3)+1 %>">
          <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-3d-tilt">
            <div class="text-warning mb-3 layer-3d-lift">
              <% for(let i=0; i<rev.rating; i++) { %>
                <i class="bi bi-star-fill"></i>
              <% } %>
            </div>
            <h5 class="fw-bold layer-3d-lift"><%= rev.title %></h5>
            <p class="text-muted small flex-grow-1 layer-3d-lift">"<%= rev.comment %>"</p>
            <div class="d-flex align-items-center gap-3 pt-3 border-top mt-auto layer-3d-lift">
              <img src="<%= rev.user ? rev.user.avatar : '/images/default-avatar.png' %>" class="rounded-circle shadow-sm" width="40" height="40" style="object-fit:cover;">
              <div>
                <div class="fw-bold"><%= rev.user ? rev.user.name : 'Verified Customer' %></div>
                <div class="small text-muted"><%= rev.tour ? rev.tour.name : 'Tour Guest' %></div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Travel Blog Preview -->
<section class="container mb-5 reveal-up perspective-container">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <span class="text-primary fw-bold text-uppercase small">Latest Travel Articles</span>
      <h2 class="fw-extrabold mb-0">From Our Travel Blog</h2>
    </div>
    <a href="/blog" class="btn btn-outline-primary rounded-pill">Read All Articles</a>
  </div>
  <div class="row g-4">
    <% latestBlogs.forEach((blog, i) => { %>
      <div class="col-md-4 reveal-up delay-<%= (i%3)+1 %>">
        <%- include('../../partials/blog_card', { blog: blog }) %>
      </div>
    <% }) %>
  </div>
</section>
