<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('#heroCarouselDots .dot');
    const creditEl = document.getElementById('heroPhotoCredit');
    const sliderEl = document.getElementById('heroSlider');

    if (!slides.length || !dots.length) return;

    let currentIndex = 0;
    let autoTimer = null;
    const slideDuration = 5000; // Auto-switch every 5 seconds

    function showSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      // Update Slides
      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });

      // Update Dots
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('active');
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.classList.remove('active');
          dot.removeAttribute('aria-current');
        }
      });

      // Update Photo Credit with smooth transition
      if (creditEl && slides[currentIndex]) {
        const credit = slides[currentIndex].getAttribute('data-credit');
        if (credit) {
          creditEl.style.opacity = '0';
          setTimeout(() => {
            creditEl.innerText = credit;
            creditEl.style.opacity = '1';
          }, 200);
        }
      }
    }

    function startTimer() {
      stopTimer();
      autoTimer = setInterval(() => {
        showSlide(currentIndex + 1);
      }, slideDuration);
    }

    function stopTimer() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    // Attach click event to each pagination dot
    dots.forEach((dot) => {
      dot.addEventListener('click', function(e) {
        e.preventDefault();
        const slideIdx = parseInt(this.getAttribute('data-slide'), 10);
        if (!isNaN(slideIdx)) {
          showSlide(slideIdx);
          startTimer(); // Reset auto timer on click
        }
      });
    });

    // Pause on mouse hover, resume on mouse leave
    if (sliderEl) {
      sliderEl.addEventListener('mouseenter', stopTimer);
      sliderEl.addEventListener('mouseleave', startTimer);
    }

    // Initialize auto play
    startTimer();

    // CTA Newsletter Form Submission (AJAX)
    const ctaForm = document.getElementById('ctaNewsletterForm');
    const ctaFeedback = document.getElementById('ctaNewsletterFeedback');
    if (ctaForm) {
      ctaForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = ctaForm.querySelector('button[type="submit"]');
        const formData = new FormData(ctaForm);
        const payload = {
          firstName: formData.get('firstName'),
          lastName: formData.get('lastName'),
          email: formData.get('email')
        };
        const originalHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Subscribing...';

        try {
          const res = await fetch('/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (ctaFeedback) {
            ctaFeedback.classList.remove('d-none', 'text-danger');
            ctaFeedback.classList.add(data.success ? 'text-warning' : 'text-danger');
            ctaFeedback.innerHTML = `<i class="bi ${data.success ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill'} me-1"></i> ${data.message || 'Thank you for subscribing!'}`;
          }
          if (data.success) {
            ctaForm.reset();
            submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Subscribed to Dispatches!';
          } else {
            submitBtn.innerHTML = originalHtml;
            submitBtn.disabled = false;
          }
        } catch (err) {
          if (ctaFeedback) {
            ctaFeedback.classList.remove('d-none');
            ctaFeedback.classList.add('text-danger');
            ctaFeedback.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Unable to connect. Please try again.';
          }
          submitBtn.innerHTML = originalHtml;
          submitBtn.disabled = false;
        }
      });
    }

    // Theme Carousel Auto-Play & Infinite Seamless Loop (Start With A Feeling)
    const themeTrack = document.getElementById('themeCarouselTrack');
    const themePrevBtn = document.getElementById('themeCarouselPrev');
    const themeNextBtn = document.getElementById('themeCarouselNext');
    const themeContainer = themeTrack ? themeTrack.closest('.theme-carousel-container') : null;

    if (themeTrack && themePrevBtn && themeNextBtn) {
      const originalSlides = Array.from(themeTrack.children);
      const originalCount = originalSlides.length;

      // Clone slides to enable continuous seamless looping without reaching boundary
      if (originalCount > 0) {
        for (let i = 0; i < 2; i++) {
          originalSlides.forEach(slide => {
            const clone = slide.cloneNode(true);
            clone.classList.add('theme-slide-clone');
            themeTrack.appendChild(clone);
          });
        }
      }

      const getScrollStep = () => {
        const firstSlide = themeTrack.querySelector('.theme-carousel-slide');
        return firstSlide ? (firstSlide.offsetWidth + 24) : 320;
      };

      const getOriginalSetWidth = () => {
        if (originalCount > 0 && themeTrack.children.length > originalCount) {
          const firstOriginal = themeTrack.children[0];
          const firstClone = themeTrack.children[originalCount];
          const calculatedWidth = firstClone.offsetLeft - firstOriginal.offsetLeft;
          if (calculatedWidth > 0) return calculatedWidth;
        }
        return originalCount * getScrollStep();
      };

      let isWrapping = false;
      const handleSeamlessWrap = () => {
        if (isWrapping) return;
        const setWidth = getOriginalSetWidth();
        if (setWidth <= 0) return;

        // When scrolled past the first full set, seamlessly wrap back by exactly 1 set width
        if (themeTrack.scrollLeft >= setWidth) {
          isWrapping = true;
          themeTrack.style.scrollSnapType = 'none';
          themeTrack.style.scrollBehavior = 'auto';
          themeTrack.scrollLeft -= setWidth;
          void themeTrack.offsetHeight; // force reflow
          themeTrack.style.scrollBehavior = 'smooth';
          themeTrack.style.scrollSnapType = 'x mandatory';
          setTimeout(() => { isWrapping = false; }, 50);
        } else if (themeTrack.scrollLeft <= 0) {
          isWrapping = true;
          themeTrack.style.scrollSnapType = 'none';
          themeTrack.style.scrollBehavior = 'auto';
          themeTrack.scrollLeft += setWidth;
          void themeTrack.offsetHeight;
          themeTrack.style.scrollBehavior = 'smooth';
          themeTrack.style.scrollSnapType = 'x mandatory';
          setTimeout(() => { isWrapping = false; }, 50);
        }
      };

      let scrollDebounceTimer = null;
      themeTrack.addEventListener('scroll', () => {
        clearTimeout(scrollDebounceTimer);
        scrollDebounceTimer = setTimeout(handleSeamlessWrap, 120);
      }, { passive: true });

      if ('onscrollend' in window) {
        themeTrack.addEventListener('scrollend', handleSeamlessWrap);
      }

      // Auto-Play Timer
      let autoPlayTimer = null;
      const AUTO_PLAY_INTERVAL = 3600; // 3.6 seconds per step

      const startAutoPlay = () => {
        if (autoPlayTimer) return;
        autoPlayTimer = setInterval(() => {
          themeTrack.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        }, AUTO_PLAY_INTERVAL);
      };

      const pauseAutoPlay = () => {
        if (autoPlayTimer) {
          clearInterval(autoPlayTimer);
          autoPlayTimer = null;
        }
      };

      let resumeTimeout = null;
      const resumeAutoPlayWithDelay = (delay = 3000) => {
        clearTimeout(resumeTimeout);
        pauseAutoPlay();
        resumeTimeout = setTimeout(() => {
          startAutoPlay();
        }, delay);
      };

      // Next & Prev Navigation
      themeNextBtn.addEventListener('click', () => {
        pauseAutoPlay();
        themeTrack.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        resumeAutoPlayWithDelay(4000);
      });

      themePrevBtn.addEventListener('click', () => {
        pauseAutoPlay();
        const setWidth = getOriginalSetWidth();
        if (themeTrack.scrollLeft <= 10 && setWidth > 0) {
          themeTrack.style.scrollSnapType = 'none';
          themeTrack.style.scrollBehavior = 'auto';
          themeTrack.scrollLeft += setWidth;
          void themeTrack.offsetHeight;
          themeTrack.style.scrollBehavior = 'smooth';
          themeTrack.style.scrollSnapType = 'x mandatory';
        }
        themeTrack.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        resumeAutoPlayWithDelay(4000);
      });

      // Pause on mouse hover & resume on mouse leave
      const interactiveElements = [themeContainer, themeTrack, themePrevBtn, themeNextBtn].filter(Boolean);
      interactiveElements.forEach(el => {
        el.addEventListener('mouseenter', pauseAutoPlay);
        el.addEventListener('mouseleave', startAutoPlay);
      });

      // Mobile touch interactions
      themeTrack.addEventListener('touchstart', pauseAutoPlay, { passive: true });
      themeTrack.addEventListener('touchend', () => resumeAutoPlayWithDelay(3500), { passive: true });

      // Tab visibility awareness
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          pauseAutoPlay();
        } else {
          startAutoPlay();
        }
      });

      // Viewport Intersection: Only auto-play when user has scrolled to Section 6
      if ('IntersectionObserver' in window && themeContainer) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              startAutoPlay();
            } else {
              pauseAutoPlay();
            }
          });
        }, { threshold: 0.15 });
        observer.observe(themeContainer);
      } else {
        startAutoPlay();
      }
    }
  });
</script>
