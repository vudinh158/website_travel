    <button type="button" class="dot active" data-slide="0" aria-label="Slide 1: Ha Long Bay" title="Ha Long Bay"></button>
    <button type="button" class="dot" data-slide="1" aria-label="Slide 2: Hoi An" title="Hoi An"></button>
    <button type="button" class="dot" data-slide="2" aria-label="Slide 3: Hanoi" title="Hanoi"></button>
    <button type="button" class="dot" data-slide="3" aria-label="Slide 4: Ninh Binh" title="Ninh Binh"></button>
    <button type="button" class="dot" data-slide="4" aria-label="Slide 5: Hue" title="Hue"></button>
