<!-- Hero Banner: Kimkim-Style Clean Natural Landscape with Real Colors & Interactive Multi-Slide Carousel -->
<div class="hero-wrapper hero-wrapper-natural text-white mb-5 position-relative overflow-hidden" id="heroSlider">
  <!-- Dynamic Slide Background Layers (Smooth Cross-Fade) -->
  <div class="hero-slides-track">
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, Alfredo H. - Visited Ha Long Bay, Jun 2025"></div>
    <div class="hero-slide" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, Sophie T. - Visited Hoi An Ancient Town, Aug 2025"></div>
    <div class="hero-slide" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, Marcus L. - Visited Hanoi Old Quarter, Sep 2025"></div>
    <div class="hero-slide" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1578637387939-43c525550085?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, David K. - Visited Ninh Binh Karst Valleys, Oct 2025"></div>
    <div class="hero-slide" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, Clara B. - Visited Hue Imperial Citadel, Nov 2025"></div>
    <div class="hero-slide" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, Elena R. - Visited Sapa Terraced Mountains, Dec 2025"></div>
    <div class="hero-slide" style="background-image: linear-gradient(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.18)), url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=90');" data-credit="Photo by Tranoi traveler, Kenji S. - Visited Phu Quoc Island Coast, Jan 2026"></div>
  </div>

  <!-- Center Main Content -->
  <div class="container py-5 my-auto text-center position-relative" style="z-index: 5;">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-9">
        <h1 class="hero-main-title mb-2">
          Personalized trips
        </h1>
        <h2 class="hero-sub-title mb-4">
          for independent travelers
        </h2>

        <!-- Main Call To Action Button (Explore All Tours) -->
        <div class="mt-4 pt-2">
          <a href="/tours" class="btn btn-hero-cta">
            Explore All Tours
          </a>
