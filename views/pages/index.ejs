<!-- Hero Banner: Tranoi Travel Vietnam -->
<div class="hero-wrapper text-white mb-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(0, 74, 173, 0.92), rgba(0, 51, 128, 0.95)), url('https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1920&q=85') center/cover no-repeat; padding: 90px 0 80px;">
  <div class="container py-lg-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="badge bg-accent text-white fw-bold px-3 py-2 rounded-pill mb-3 text-uppercase tracking-wider shadow-sm d-inline-flex align-items-center gap-2">
          <i class="bi bi-geo-alt-fill"></i> Vietnam Specialty Travel Agency
        </span>
        <h1 class="display-3 fw-extrabold text-white mb-3">
          Travel more, plan less.
        </h1>
        <p class="fs-5 text-light opacity-90 mb-4 pe-lg-4 leading-relaxed">
          Tailored, curated trips across Vietnam within our specialty destinations and packages. Choose between fully chauffeured private tours and our smart partial-guided long-duration journeys.
        </p>
        
        <!-- Duration Quick Filters (7, 10, 14, 21 Days) -->
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
          <span class="text-white-50 small fw-bold text-uppercase me-1">Popular Durations:</span>
          <a href="/tours?duration=7" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1">7 Days</a>
          <a href="/tours?duration=10" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1">10 Days</a>
          <a href="/tours?duration=14" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1">14 Days</a>
          <a href="/tours?duration=21" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1">21 Days</a>
        </div>

        <div class="d-flex flex-wrap gap-3">
          <a href="/tours" class="btn btn-accent btn-lg px-4 py-3 rounded-pill shadow-lg fw-bold">
            Explore Vietnam Tours <i class="bi bi-arrow-right ms-1"></i>
          </a>
          <a href="/vietnam" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill fw-semibold">
            All 17 Destinations
          </a>
        </div>
      </div>

      <!-- Quick Search Widget -->
      <div class="col-lg-5">
        <div class="bg-white text-dark p-4 p-lg-5 rounded-4 shadow-lg border">
          <h4 class="fw-bold mb-2 text-primary"><i class="bi bi-sliders me-2"></i>Find Your Curated Trip</h4>
          <p class="text-muted small mb-4">Select your preferred duration, style, or region.</p>
          
          <form action="/tours" method="GET" class="d-flex flex-column gap-3">
            <div>
              <label class="form-label small fw-bold text-muted">Tour Format</label>
              <select name="format" class="form-select form-select-lg">
                <option value="">Both Private &amp; Partial-Guided</option>
                <option value="partial-guided">Partial-Guided (Curated Balance)</option>
                <option value="private">Private (Dedicated Guide &amp; Car)</option>
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold text-muted">Duration</label>
              <select name="duration" class="form-select form-select-lg">
                <option value="">Any Duration</option>
                <option value="7">7 Days (Essential North)</option>
                <option value="10">10 Days (Classic Highlights)</option>
                <option value="14">14 Days (Grand Explorer)</option>
                <option value="21">21 Days (Complete Expedition)</option>
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold text-muted">Region Focus</label>
              <select name="region" class="form-select form-select-lg">
                <option value="all">All Regions</option>
                <option value="north">North Vietnam (Hanoi, Ha Long, Sapa)</option>
                <option value="central">Central Vietnam (Hue, Hoi An, Da Nang)</option>
                <option value="south">South Vietnam (Saigon, Mekong Delta)</option>
                <option value="multi-region">Multi-Region (Cross-Country)</option>
              </select>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 rounded-pill fw-bold shadow mt-2">
              <i class="bi bi-search me-2"></i> View Matching Tours
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Core Differentiator: Why Partial-Guided? -->
<div class="container my-5 py-4">
  <div class="card border-0 rounded-4 p-4 p-lg-5 shadow-sm" style="background: #f1f6fc; border-left: 6px solid var(--primary-color) !important;">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <span class="badge badge-partial-guided mb-2">The Tranoi Travel Standard</span>
        <h3 class="fw-bold text-primary mb-3">Why Travelers Choose Our Partial-Guided Format</h3>
        <p class="text-secondary leading-relaxed mb-3">
          Traditional group tours rush you from monument to monument on rigid schedules. Independent planning leaves you stuck organizing airport transfers, booking tickets, and worrying about logistics.
        </p>
        <p class="text-secondary leading-relaxed mb-0">
          Our <strong>partial-guided</strong> format solves both: our certified local insiders guide you through intricate cultural treasures (like Hanoi street guilds and Hue imperial palaces), while generous unguided leisure windows let you explore cafes, beaches, and shops at your own pace. All logistics, domestic flights, and boutique stays are 100% arranged.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a href="/experiences/what-partial-guided-feels-like" class="btn btn-primary px-4 py-3 rounded-pill fw-bold">
          Learn How It Works &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Launch Seed Tours Showcase (Section 5) -->
<div class="container my-5 py-2">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="text-accent text-uppercase fw-bold small tracking-wider">Curated Vietnam Journeys</span>
      <h2 class="display-6 fw-extrabold mb-1">Featured Seed Tours</h2>
      <p class="text-muted mb-0">Each tour features an in-page toggle between Private and Partial-guided formats.</p>
    </div>
    <a href="/tours" class="btn btn-outline-primary rounded-pill fw-bold px-4 mt-3 mt-md-0">View All Tours &rarr;</a>
  </div>

  <div class="row g-4">
    <% seedTours.forEach(tour => { %>
      <div class="col-lg-6">
        <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden tour-card-hover transition-smooth bg-white">
          <div class="position-relative" style="height: 260px;">
            <img src="<%= tour.featuredImage %>" alt="<%= tour.name %>" class="w-100 h-100" style="object-fit: cover;">
            <div class="position-absolute top-0 start-0 m-3 d-flex gap-2">
              <span class="badge bg-primary text-white rounded-pill px-3 py-2"><%= tour.duration %></span>
              <span class="badge bg-accent text-white rounded-pill px-3 py-2">Private &amp; Partial-Guided</span>
            </div>
            <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
              <span class="text-white small fw-semibold"><i class="bi bi-geo-alt-fill text-accent me-1"></i> <%= tour.departureLocation %></span>
            </div>
          </div>

          <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-primary border"><i class="bi bi-clock me-1"></i> <%= tour.pace %> Pace</span>
                <span class="text-warning small fw-bold"><i class="bi bi-star-fill me-1"></i> <%= tour.rating.toFixed(2) %> (<%= tour.totalReviews %> reviews)</span>
              </div>
              <h4 class="card-title fw-bold mb-3">
                <a href="/tours/<%= tour.slug %>" class="text-dark text-decoration-none hover-primary">
                  <%= tour.name %>
                </a>
              </h4>
              <p class="card-text text-secondary small leading-relaxed mb-4">
                <%= truncateText(tour.shortDescription, 140) %>
              </p>
            </div>

            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
              <div>
                <span class="text-muted small d-block">From</span>
                <span class="fs-4 fw-extrabold text-primary">$<%= Math.round(tour.pricePartialGuided || tour.discountPrice || tour.price) %></span>
                <span class="text-muted small">/ guest</span>
              </div>
              <a href="/tours/<%= tour.slug %>" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                View Itinerary
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- P0 Destinations Showcase (Section 3) -->
<div class="container my-5 py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="text-accent text-uppercase fw-bold small tracking-wider">Where We Travel</span>
      <h2 class="display-6 fw-extrabold mb-1">Key Vietnam Destinations</h2>
      <p class="text-muted mb-0">From ancient northern capitals to lantern-lit merchant ports and southern waterways.</p>
    </div>
    <a href="/vietnam" class="btn btn-outline-primary rounded-pill fw-bold px-4 mt-3 mt-md-0">All 17 Destinations &rarr;</a>
  </div>

  <div class="row g-4">
    <% p0Destinations.forEach(dest => { %>
      <div class="col-md-4 col-sm-6">
        <a href="/vietnam/<%= dest.slug %>" class="text-decoration-none">
          <div class="card border-0 rounded-4 overflow-hidden shadow-sm position-relative text-white group-hover-zoom" style="height: 260px;">
            <img src="<%= dest.banner %>" alt="<%= dest.name %>" class="w-100 h-100" style="object-fit: cover; transition: transform 0.5s ease;">
            <div class="position-absolute inset-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%);"></div>
            <div class="position-absolute bottom-0 start-0 p-4 w-100">
              <span class="badge bg-white text-primary text-uppercase small mb-2 fw-bold"><%= dest.region.toUpperCase() %> VIETNAM</span>
              <h4 class="fw-bold text-white mb-1"><%= dest.name %></h4>
              <p class="text-light opacity-90 small mb-0"><%= truncateText(dest.description, 70) %></p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</div>

<!-- Customer Stories & Social Proof (Section 9 & 10) -->
<div class="container my-5 py-4">
  <div class="bg-light p-4 p-lg-5 rounded-4 border">
    <div class="row g-4 align-items-center mb-4">
      <div class="col-lg-8">
        <span class="text-accent text-uppercase fw-bold small tracking-wider">Real Guest Experiences</span>
        <h2 class="fw-extrabold mb-1">Stories from the Road</h2>
        <p class="text-muted mb-0">Read how real families, couples, and independent travelers experienced our curated journeys.</p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a href="/customer-stories" class="btn btn-outline-primary rounded-pill fw-bold">Read All Stories &rarr;</a>
      </div>
    </div>

    <div class="row g-4">
      <% customerStories.forEach(story => { %>
        <div class="col-lg-6">
          <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white">
            <div class="d-flex align-items-center gap-3 mb-3">
              <img src="<%= story.heroImage %>" alt="<%= story.travelerName %>" class="rounded-circle" width="56" height="56" style="object-fit: cover;">
              <div>
                <h5 class="fw-bold mb-0"><%= story.travelerName %></h5>
                <span class="text-muted small"><%= story.travelerLocation %> &bull; <%= story.tourTitle %></span>
              </div>
            </div>
            <p class="text-secondary fst-italic mb-3">
              &ldquo;<%= story.travelerQuote %>&rdquo;
            </p>
            <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
              <span class="badge badge-partial-guided"><%= story.formatTaken === 'private' ? 'Private Tour' : 'Partial-Guided' %></span>
              <a href="/customer-stories/<%= story.slug %>" class="text-primary fw-bold text-decoration-none small">Read full story &rarr;</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- The Tranoi Travel Promise Pillars -->
<div class="container my-5 py-4">
  <div class="text-center mb-5">
    <span class="text-accent text-uppercase fw-bold small tracking-wider">The Tranoi Difference</span>
    <h2 class="display-6 fw-extrabold">How We Curate Your Journey</h2>
  </div>

  <div class="row g-4 text-center">
    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-white shadow-sm border h-100">
        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
          <i class="bi bi-compass fs-4"></i>
        </div>
        <h5 class="fw-bold mb-2">Curated Expertise</h5>
        <p class="text-secondary small leading-relaxed mb-0">
          We specialize solely in destinations we know intimately. Itineraries are refined within our expertise, not built from scratch to random guesses.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-white shadow-sm border h-100">
        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
          <i class="bi bi-people fs-4"></i>
        </div>
        <h5 class="fw-bold mb-2">Handpicked Insiders</h5>
        <p class="text-secondary small leading-relaxed mb-0">
          Licensed local storytellers, architects, and food historians who treat you like a visiting friend rather than reciting memorized scripts.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-white shadow-sm border h-100">
        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
          <i class="bi bi-shield-check fs-4"></i>
        </div>
        <h5 class="fw-bold mb-2">24/7 Care Promise</h5>
        <p class="text-secondary small leading-relaxed mb-0">
          Direct private WhatsApp concierge channel with our local team. Seamless flight monitoring, instant restaurant reservations, and complete peace of mind.
        </p>
      </div>
    </div>
  </div>
</div>
