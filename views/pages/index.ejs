      <div class="hero-trust-header d-flex align-items-center gap-2 mb-1">
        <span class="hero-trust-stars text-warning">★★★★★</span>
        <span class="hero-trust-title"><strong>Our customers say: Excellent</strong> 4.9/5</span>
        <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.72rem;">1,480+ reviews</span>
      </div>
      <div class="hero-press-caption">
        Our local travel specialists have been recommended by
      </div>
      <div class="hero-press-logos mt-2 d-flex align-items-center gap-3">
        <span class="press-item press-bbc">BBC</span>
        <span class="press-item press-tc"><span class="tc-icon">TC</span>TechCrunch</span>
        <span class="press-item press-nyt">The New York Times</span>
      </div>
    </div>

    <!-- Right: Dynamic Photo Credit (Matches Screenshot "Photo by traveler...") -->
    <div class="hero-photo-credit" id="heroPhotoCredit">
      Photo by Tranoi traveler, Alfredo H. - Visited Ha Long Bay, Jun 2025
    </div>
  </div>
</div>

<!-- Core Differentiator: Why Partial-Guided? -->
<div class="container my-5 py-3">
  <div class="card border-0 rounded-4 p-4 p-lg-5 shadow-sm standard-differentiator-card" style="background: #f1f6fc; border-left: 6px solid var(--primary-color) !important;">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <span class="badge badge-partial-guided mb-2">The Tranoi Travel Standard</span>
        <h3 class="fw-bold text-primary mb-3">Why Travelers Choose Our Partial-Guided Format</h3>
        <p class="text-secondary leading-relaxed mb-3">
          Traditional group tours rush you from monument to monument on rigid schedules. Independent planning leaves you stuck organizing airport transfers, booking tickets, and worrying about logistics.
        </p>
        <p class="text-secondary leading-relaxed mb-0">
          Our <strong>partial-guided</strong> format solves both: our certified local insiders guide you through intricate cultural treasures (like Hanoi street guilds and Hue imperial palaces), while generous unguided leisure windows let you explore cafes, beaches, and shops at your own pace. All logistics, domestic flights, and boutique stays are 100% arranged.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a href="/experiences/what-partial-guided-feels-like" class="btn btn-primary px-4 py-3 rounded-pill fw-bold">
          Learn How It Works &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Value Propositions Icon Row (4 Items Evenly Spaced) -->
  <div class="why-us-features-wrapper mt-5 pt-3">
    <div class="row g-4 align-items-center justify-content-between why-us-features-row">
      <!-- Item 1: Compass -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="why-us-feature-item">
          <div class="why-us-feature-icon">
            <i class="bi bi-compass"></i>
          </div>
          <div class="why-us-feature-text">
            <span class="why-us-feature-label">Specialist, not generalist</span>
          </div>
        </div>
      </div>

      <!-- Item 2: Map-pin or heart -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="why-us-feature-item">
          <div class="why-us-feature-icon">
            <i class="bi bi-geo-alt"></i>
          </div>
          <div class="why-us-feature-text">
            <span class="why-us-feature-label">Authentic and personalized experience</span>
          </div>
        </div>
      </div>

      <!-- Item 3: Route or map -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="why-us-feature-item">
          <div class="why-us-feature-icon">
            <i class="bi bi-map"></i>
          </div>
          <div class="why-us-feature-text">
            <span class="why-us-feature-label">Hassle-free planning with our local travel expert</span>
          </div>
        </div>
      </div>

      <!-- Item 4: Headset -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="why-us-feature-item">
          <div class="why-us-feature-icon">
            <i class="bi bi-headset"></i>
          </div>
          <div class="why-us-feature-text">
            <span class="why-us-feature-label">Easy travel, 24/7 support</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Centered CTA Button: Explore Tours -->
    <div class="text-center mt-4 pt-3">
      <a href="/tours" class="btn btn-why-us-cta">
        Explore Tours
      </a>
    </div>
  </div>
</div>

<!-- Launch Seed Tours Showcase (Section 5) -->
<div class="container my-5 py-2">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="text-accent text-uppercase fw-bold small tracking-wider">TRANOI'S SIGNATURE JOURNEYS</span>
      <h2 class="display-6 fw-extrabold mb-1">Featured Tours</h2>
      <p class="text-muted mb-0">Every journey below can be booked Private or Partial-guided, pick your pace on the tour page.</p>
    </div>
    <a href="/tours" class="btn btn-outline-primary rounded-pill fw-bold px-4 mt-3 mt-md-0">View All Tours &rarr;</a>
  </div>

  <div class="row g-4">
    <% seedTours.forEach(tour => { 
      const routeStops = (tour.destinations && Array.isArray(tour.destinations) && tour.destinations.length > 0)
        ? tour.destinations
        : (tour.routeMapPoints ? (() => {
            try {
              const pts = typeof tour.routeMapPoints === 'string' ? JSON.parse(tour.routeMapPoints) : tour.routeMapPoints;
              return Array.isArray(pts) ? pts.map(p => p.name || p) : [];
            } catch(e) { return []; }
          })() : []);
      const routeString = routeStops.join(' → ');
      const cleanName = tour.name.replace(/\s*-\s*(Private|Partial-Guided|Guided).*$/i, '').trim();
      let rhythmText = 'Guided mornings, free afternoons';
      if (tour.durationDays >= 10 && tour.durationDays < 14) {
        rhythmText = 'Full days, active exploring';
      } else if (tour.durationDays >= 14) {
        rhythmText = 'Balanced rhythm, guided highlights & free days';
      }
    %>
      <div class="col-lg-6">
        <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden tour-card-hover transition-smooth bg-white">
          <div class="position-relative" style="height: 260px;">
            <a href="/tours/<%= tour.slug %>" class="d-block w-100 h-100">
              <img src="<%= tour.featuredImage %>" alt="<%= cleanName %>" class="w-100 h-100" style="object-fit: cover;">
            </a>
            <!-- Single Duration Badge -->
            <div class="position-absolute top-0 start-0 m-3">
              <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); font-size: 0.82rem; color: #ffffff;">
                <%= tour.duration %>
              </span>
            </div>
          </div>

          <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
              <!-- Route pulled directly from tour.destinations, in order -->
              <% if (routeString) { %>
                <div class="tour-route-stops mb-2">
                  <%= routeString %>
                </div>
              <% } %>

              <h4 class="card-title fw-bold mb-2">
                <a href="/tours/<%= tour.slug %>" class="text-dark text-decoration-none hover-primary">
                  <%= cleanName %>
                </a>
              </h4>

              <p class="card-text text-secondary small leading-relaxed mb-3">
                <%= tour.shortDescription %>
              </p>

              <!-- Travel pace & activity rhythm -->
              <div class="tour-pace-rhythm d-flex align-items-center gap-2 small mb-3">
                <i class="bi bi-person-walking text-accent"></i>
                <span class="text-secondary"><%= rhythmText %></span>
              </div>
            </div>

            <!-- Bottom Price & Rating Row -->
            <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
              <div class="d-flex align-items-baseline gap-1">
                <span class="text-muted small">From</span>
                <span class="fs-5 fw-bold text-dark">$<%= Number(Math.round(tour.pricePartialGuided || tour.discountPrice || tour.price)).toLocaleString() %></span>
                <span class="text-muted small">pp</span>
              </div>
              <div class="small fw-semibold">
                <span class="text-warning">★</span> <span class="text-dark"><%= Number(tour.rating).toFixed(2) %></span> <span class="text-muted">(<%= tour.totalReviews %>)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- P0 Destinations Showcase (Section 3) -->
<div class="container my-5 py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="text-accent text-uppercase fw-bold small tracking-wider">PLACES YOU'LL VISIT</span>
      <h2 class="display-6 fw-extrabold mb-1">Destinations Woven Into Every Journey</h2>
      <p class="text-muted mb-0">Most of our trips move through several of these places at once. Explore each one to see what's waiting along the way.</p>
    </div>
    <a href="/vietnam" class="btn btn-outline-primary rounded-pill fw-bold px-4 mt-3 mt-md-0">View All Destinations &rarr;</a>
  </div>

  <div class="row g-4">
    <% p0Destinations.forEach(dest => { %>
      <div class="col-md-4 col-sm-6">
        <a href="/vietnam/<%= dest.slug %>" class="text-decoration-none">
          <div class="card border-0 rounded-4 overflow-hidden shadow-sm position-relative text-white group-hover-zoom" style="height: 260px;">
            <img src="<%= dest.banner %>" alt="<%= dest.name %>" class="w-100 h-100" style="object-fit: cover; transition: transform 0.5s ease;">
            <div class="position-absolute inset-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%);"></div>
            <div class="position-absolute bottom-0 start-0 p-4 w-100">
              <span class="badge bg-white text-primary text-uppercase small mb-2 fw-bold"><%= dest.region.toUpperCase() %> VIETNAM</span>
              <h4 class="fw-bold text-white mb-1"><%= dest.name %></h4>
              <p class="text-light opacity-90 small mb-0 destination-card-desc"><%= dest.description %></p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</div>

<!-- Explore by Theme: Start With A Feeling (Section 6) -->
<% if (typeof featuredThemes !== 'undefined' && featuredThemes && featuredThemes.length > 0) { 
  const themeMetaMap = {
    'honeymoon': {
      name: 'Honeymoon',
      subtitle: 'Romantic stays & secluded escapes',
      image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80'
    },
    'family': {
      name: 'Family',
      subtitle: 'Engaging travel for all generations',
      image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80'
    },
    'adventure': {
      name: 'Adventure',
      subtitle: 'Treks, caves & cycling trails',
      image: 'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=800&q=80'
    },
    'culinary': {
      name: 'Culinary',
      subtitle: 'Street food, markets & royal flavors',
      image: 'https://images.unsplash.com/photo-1557750298-17ae4f2c0cf6?auto=format&fit=crop&w=800&q=80'
    }
  };
%>
<div class="container my-5 py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="text-accent text-uppercase fw-bold small tracking-wider">NOT SURE YET?</span>
      <h2 class="display-6 fw-extrabold mb-1">Start With A Feeling.</h2>
      <p class="text-muted mb-0">Pick a theme. We will find your suitable tours.</p>
    </div>
    <a href="/themes" class="btn btn-outline-primary rounded-pill fw-bold px-4 mt-3 mt-md-0">View All Themes &rarr;</a>
  </div>

  <!-- 4 Curated Theme Cards Grid -->
  <div class="row g-4">
    <% featuredThemes.forEach(theme => { 
      const meta = themeMetaMap[theme.slug] || {
        name: theme.slug.charAt(0).toUpperCase() + theme.slug.slice(1),
        subtitle: theme.tagline || 'Curated Vietnam experiences',
        image: theme.heroImage
      };
      const cardImg = meta.image || theme.heroImage;
    %>
      <div class="col-12 col-sm-6 col-lg-3">
        <a href="/<%= theme.slug %>" class="text-decoration-none d-block h-100">
          <div class="card border-0 rounded-4 overflow-hidden position-relative theme-card-item shadow-sm h-100">
            <img src="<%= cardImg %>" alt="<%= meta.name %>" class="theme-card-img w-100 h-100">
            <div class="theme-card-overlay position-absolute inset-0 w-100 h-100"></div>

            <!-- Top-right circular arrow button matching reference screenshot -->
            <div class="position-absolute top-0 end-0 m-3">
              <div class="theme-card-arrow-circle">
                <i class="bi bi-arrow-up-right"></i>
              </div>
            </div>

            <!-- Bottom Content (Icon + Theme Name + Subtitle) -->
            <div class="position-absolute bottom-0 start-0 p-4 w-100">
              <div class="d-flex align-items-center gap-2 text-white fw-bold fs-5 mb-1 theme-card-title">
                <i class="bi bi-geo-alt-fill text-accent" style="font-size: 1.05rem;"></i>
                <span><%= meta.name %></span>
              </div>
              <p class="text-white opacity-90 small mb-0 theme-card-subtitle">
                <%= meta.subtitle %>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- Customer Stories & Social Proof (Section 9 & 10) -->
<div class="container my-5 py-4">
  <div class="bg-light p-4 p-lg-5 rounded-4 border">
    <div class="row g-4 align-items-center mb-4">
      <div class="col-lg-8">
        <span class="text-accent text-uppercase fw-bold small tracking-wider">REAL GUEST REVIEWS</span>
        <h2 class="display-6 fw-extrabold mb-1">Stories from the Road</h2>
        <p class="text-muted mb-0">Real families and couples on what their Tranoi journey actually looked like.</p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a href="/trip-reviews" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">Read All Reviews &rarr;</a>
      </div>
    </div>

    <div class="row g-4">
      <% customerStories.forEach(story => { 
        let segment = { label: 'Family Trip', slug: 'family' };
        const storyText = ((story.title || '') + ' ' + (story.travelerQuote || '') + ' ' + (story.travelerName || '')).toLowerCase();
        if (storyText.includes('honeymoon') || storyText.includes('couple') || storyText.includes('claire & robert') || storyText.includes('vance')) {
          segment = { label: 'Honeymoon', slug: 'honeymoon' };
        }
      %>
        <div class="col-lg-6">
          <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between testimonial-card-item">
            <div>
              <div class="d-flex align-items-center gap-3 mb-3">
                <img src="<%= story.heroImage %>" alt="<%= story.travelerName %>" class="rounded-circle" width="56" height="56" style="object-fit: cover;">
                <div>
                  <h5 class="fw-bold mb-1 text-dark"><%= story.travelerName %></h5>
                  <span class="text-muted small"><%= story.travelerLocation %> &bull; <%= story.tourTitle %></span>
                </div>
              </div>

              <!-- Star Rating (★★★★★ 5.0) -->
              <div class="d-flex align-items-center gap-1 mb-3">
                <span class="text-warning small" style="color: #f59e0b !important; letter-spacing: 2px;">★★★★★</span>
                <span class="fw-semibold text-dark small ms-1"><%= Number(story.rating || 5).toFixed(1) %></span>
              </div>

              <p class="text-secondary fst-italic leading-relaxed mb-4" style="font-size: 0.95rem;">
                &ldquo;<%= story.travelerQuote %>&rdquo;
              </p>
            </div>

            <!-- Segment Badge, Format Badge, and Card Link -->
            <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
              <div class="d-flex align-items-center gap-2">
                <a href="/<%= segment.slug %>" class="badge badge-segment-pill rounded-pill px-3 py-2 text-decoration-none fw-semibold" style="font-size: 0.8rem;">
                  <%= segment.label %>
                </a>
                <span class="text-secondary small fw-medium ms-1">
                  <%= story.formatTaken === 'private' ? 'Private Tour' : 'Partial-Guided' %>
                </span>
              </div>
              <a href="/customer-stories/<%= story.slug %>" class="text-primary fw-semibold text-decoration-none small hover-underline">
                Read full story &rarr;
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

