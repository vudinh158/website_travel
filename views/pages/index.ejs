    <!-- Card 2: Your Local Storyteller -->
    <div class="col-md-4">
      <div class="p-4 p-lg-5 rounded-4 bg-white shadow-sm border h-100 d-flex flex-column align-items-center text-center promise-pillar-card">
        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3 flex-shrink-0" style="width: 64px; height: 64px;">
          <i class="bi bi-chat-heart fs-3"></i>
        </div>
