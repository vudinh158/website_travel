    'honeymoon': {
      name: 'Honeymoon',
      subtitle: 'Romantic stays & secluded escapes',
      image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80'
    },
    'family': {
      name: 'Family',
      subtitle: 'Engaging travel for all generations',
      image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80'
    },
    'adventure': {
      name: 'Adventure',
      subtitle: 'Treks, caves & cycling trails',
      image: 'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=800&q=80'
    },
    'culinary': {
      name: 'Culinary',
      subtitle: 'Street food, markets & royal flavors',
      image: 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80'
    },
    'eco-tours': {
      name: 'Eco-Tours',
      subtitle: 'Responsible travel & natural sanctuaries',
      image: 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80'
    },
    'veterans-tours': {
      name: 'Veterans & Heritage',
      subtitle: 'Remembrance & historical landmarks',
      image: 'https://images.unsplash.com/photo-1578637387939-43c525550085?auto=format&fit=crop&w=800&q=80'
    },
    'educational-tours': {
      name: 'Educational',
      subtitle: 'Cultural immersion & student expeditions',
      image: 'https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=800&q=80'
    }
  };
%>
<div class="container my-5 py-4">
  <!-- Section Header with Carousel Navigation Arrows (View All Themes button removed) -->
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="text-accent text-uppercase fw-bold small tracking-wider">NOT SURE YET?</span>
      <h2 class="display-6 fw-extrabold mb-1">Start With A Feeling.</h2>
      <p class="text-muted mb-0">Pick a theme. We will find your suitable tours.</p>
    </div>
    
    <!-- Carousel Controls (Previous / Next Arrows) -->
    <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
      <button type="button" class="theme-nav-arrow" id="themeCarouselPrev" aria-label="Previous Themes">
        <i class="bi bi-chevron-left"></i>
      </button>
      <button type="button" class="theme-nav-arrow" id="themeCarouselNext" aria-label="Next Themes">
        <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- All Themes Carousel Track -->
  <div class="theme-carousel-container position-relative">
    <div class="theme-carousel-track d-flex gap-4 pt-3 pb-3" id="themeCarouselTrack">
      <% featuredThemes.forEach(theme => { 
        const meta = themeMetaMap[theme.slug] || {
          name: theme.title.replace(/^Vietnam\s+/i, '').split(':')[0].trim(),
          subtitle: theme.tagline || 'Curated Vietnam experiences',
          image: theme.heroImage
        };
        const cardImg = meta.image || theme.heroImage;
      %>
        <div class="theme-carousel-slide">
          <a href="/<%= theme.slug %>" class="text-decoration-none d-block h-100 rounded-4">
            <div class="card border-0 rounded-4 overflow-hidden position-relative theme-card-item shadow-sm h-100">
              <img src="<%= cardImg %>" alt="<%= meta.name %>" class="theme-card-img w-100 h-100 rounded-4" loading="lazy">
              <div class="theme-card-overlay position-absolute inset-0 w-100 h-100 rounded-4"></div>

              <!-- Top-right circular arrow button -->
              <div class="position-absolute top-0 end-0 m-3">
                <div class="theme-card-arrow-circle">
                  <i class="bi bi-arrow-up-right"></i>
                </div>
              </div>

              <!-- Bottom Content (Icon + Theme Name + Subtitle) -->
              <div class="position-absolute bottom-0 start-0 p-4 w-100">
                <div class="d-flex align-items-center gap-2 text-white fw-bold fs-5 mb-1 theme-card-title">
                  <i class="bi bi-geo-alt-fill text-accent" style="font-size: 1.05rem;"></i>
                  <span><%= meta.name %></span>
                </div>
