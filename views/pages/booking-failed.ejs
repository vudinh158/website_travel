<div class="container py-5 text-center" style="max-width: 600px;">
  <div class="card border-0 shadow-lg p-5 rounded-4">
    <i class="bi bi-x-circle-fill display-1 text-danger mb-3"></i>
    <h2 class="fw-extrabold mb-2">Payment Transaction Failed</h2>
    <p class="text-muted mb-4"><%= error %></p>
    <div class="d-flex gap-3 justify-content-center">
      <a href="/tours" class="btn btn-wanderlust rounded-pill px-4">Try Again</a>
      <a href="/contact" class="btn btn-outline-secondary rounded-pill px-4">Contact Support</a>
    </div>
  </div>
</div>
