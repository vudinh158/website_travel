PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / SQLite fallback)
DB_DIALECT=sqlite
DB_STORAGE=database/travel_tour.sqlite
# For PostgreSQL:
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=website_travel
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT Secret
JWT_SECRET=travel_tour_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Express Session Secret
SESSION_SECRET=travel_tour_session_secret_key_2026

# Stripe Payment Gateway Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_sample_key
STRIPE_SECRET_KEY=sk_test_sample_key
STRIPE_WEBHOOK_SECRET=whsec_sample_key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=sample_secret

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=support@website-travel.com
EMAIL_PASS=sample_password
EMAIL_FROM="WanderLust Tours <support@website-travel.com>"

# Google OAuth (Passport.js)
GOOGLE_CLIENT_ID=google_client_id_placeholder
GOOGLE_CLIENT_SECRET=google_client_secret_placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
